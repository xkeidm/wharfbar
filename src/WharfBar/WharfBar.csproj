<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom Main (Program.cs) branches to the headless taskbar watchdog before WPF boots. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>WharfBar</RootNamespace>
    <AssemblyName>WharfBar</AssemblyName>
    <!-- First public beta: shell features are in; Stable 1.0 is the exit milestone.
         AssemblyVersion stays 1.0.0.0; UI reads InformationalVersion. -->
    <Version>1.0.0-beta.3</Version>
    <InformationalVersion>1.0.0-beta.3</InformationalVersion>
    <Product>WharfBar</Product>
    <Description>Windows üst bar + dock (Fluent)</Description>
    <ApplicationIcon>Assets\WharfBar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <CustomToolNamespace>WharfBar.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <Resource Include="Assets\WharfBar.png" />
    <Content Include="Wallpapers\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
