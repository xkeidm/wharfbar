<Window x:Class="WharfBar.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WharfBar.Resources"
        xmlns:local="clr-namespace:WharfBar.Views"
        Title="WharfBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        MinHeight="30"
        MaxHeight="30"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <!-- AllowsTransparency is set in the ctor from TopBar.BackgroundMode (before
         InitializeComponent) — never put it in XAML. Mica requires false; translucent
         modes require true; never pair AllowsTransparency=true with Mica. The brand logo
         uses geometry (not a font glyph) so Mica / missing MDL2 faces cannot blank it.
         Quick Settings flyout Popup stays opaque Fluent (AllowsTransparency=False). -->

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- ContextMenu / MenuItem: App.xaml BasedOn WPF-UI (do not redefine without BasedOn). -->
        <Style x:Key="StatusHit" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bar.HitFill}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.TextPrimary}" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.TextPrimary}" />
        </Style>
        <!-- Center island chip. WinUI control fill + 1px stroke, light and dark.
             Idle is a short indicator (glyph + label), not a bare hit-plate.
             Hover uses the next control fill; width eases in code. -->
        <Style x:Key="IslandPillHit" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bar.PillFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bar.PillStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bar.PillFillHover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Satellite chip inside the island pill: subtle fill on hover; the accent ring (selection) is set in code. -->
        <Style x:Key="IslandSatelliteHit" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bar.SubtleFill}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Single-line clock+date (current-culture abbreviations); sits beside notification bell. -->
        <Style x:Key="ClockCombinedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.TextPrimary}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Background="Transparent">
        <Grid x:Name="BarGrid" Margin="10,0">
            <!-- Left cluster: brand logo (logoStyle) + System Stats monitor -->
            <StackPanel x:Name="LeftCluster"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Border x:Name="AppMenuButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Padding="6,4"
                        Cursor="Hand"
                        ToolTipService.InitialShowDelay="800">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_Menu}" />
                    </Border.ToolTip>
                    <Border.ContextMenu>
                        <ContextMenu x:Name="AppMenu" Loaded="OnAppMenuLoaded">
                            <MenuItem Header="{x:Static res:Strings.TopBar_PcSettings}" Click="OnOpenWindowsSettingsClick" />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Profile}" Click="OnOpenProfileClick" />
                            <MenuItem Header="{x:Static res:Strings.TopBar_AboutPc}" Click="OnOpenAboutPcClick" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Lock}" Click="OnLockClick" />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Sleep}" Click="OnSleepClick" />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Shutdown}" Click="OnShutdownClick" />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Restart}" Click="OnRestartClick" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.TopBar_WharfBarSettings}" Click="OnSettingsClick" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.TopBar_About}" Click="OnAboutClick" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.TopBar_Quit}" Click="OnQuitClick" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <!-- 128 grid from BrandLogo.BarGlyph (logoStyle); the Canvas keeps the
                         grid padding so both logos sit on the same optical box. -->
                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                        <Canvas Width="128" Height="128">
                            <Path x:Name="AppLogoGlyph"
                                  Fill="{DynamicResource Bar.TextPrimary}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- System stats readout: "CPU 12% · GPU0 4% · GPU1 24% · RAM 47%" (SystemStatsService;
                     GPU segments numbered only with topBar.showGpuPerAdapter and 2+ adapters).
                     Hidden when topBar.showSystemStats is false; segments with no data drop out. -->
                <!-- Sparkline is the hover card, built in code. A line plus this text would push the 30 DIP bar. -->
                <TextBlock x:Name="SystemStatsText"
                           Style="{StaticResource StatusLabel}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="--" />
            </StackPanel>

            <!-- Island chip: idle indicator (glyph + "Clipboard"), now-playing title, or a meter.
                 Compact states stay inside the 30 DIP bar. The popup below is the
                 only expanded surface. Drop/DragOver/click stay on this control.
                 Width animates in TopBarWindow.Island.cs; title growth is capped there. -->
            <Border x:Name="IslandPill"
                    Style="{StaticResource IslandPillHit}"
                    Margin="24,0"
                    Visibility="Collapsed"
                    AllowDrop="True"
                    Focusable="True"
                    AutomationProperties.Name="{x:Static res:Strings.Island_Clipboard}"
                    MouseEnter="OnIslandPillEnter"
                    MouseLeave="OnIslandPillLeave"
                    MouseLeftButtonUp="OnIslandPillClick"
                    PreviewMouseLeftButtonDown="OnIslandPillPreviewMouseDown"
                    PreviewKeyDown="OnIslandPillPreviewKeyDown"
                    Drop="OnIslandPillDrop"
                    DragEnter="OnIslandPillDragEnter"
                    DragLeave="OnIslandPillDragLeave"
                    DragOver="OnIslandDragOver">
                <StackPanel x:Name="IslandContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="IslandGlyph"
                               FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="13"
                               Width="16"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Bar.TextPrimary}"
                               Text="&#xE8C8;" />
                    <Border x:Name="IslandCoverThumb"
                            Width="16"
                            Height="16"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,16,16" RadiusX="4" RadiusY="4" />
                        </Border.Clip>
                        <Image x:Name="IslandCoverImage" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock x:Name="IslandIdleCaption"
                               FontFamily="{DynamicResource AppTextFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Bar.TextPrimary}"
                               Text="{x:Static res:Strings.Island_Clipboard}" />
                    <Image x:Name="IslandCamera"
                           Width="36"
                           Height="16"
                           Margin="8,0,0,0"
                           Stretch="UniformToFill"
                           Visibility="Collapsed" />
                    <TextBlock x:Name="IslandTitle"
                               Style="{StaticResource StatusLabel}"
                               Margin="0"
                               MaxWidth="0"
                               Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <!-- Trailing equalizer; heights come from AudioPeak (default render). -->
                    <StackPanel x:Name="IslandBars"
                                Orientation="Horizontal"
                                Height="14"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border x:Name="IslandBar0" Width="2.5" Height="14" Margin="0,0,2.5,0" VerticalAlignment="Bottom" CornerRadius="1.25" RenderTransformOrigin="0,1" Background="{DynamicResource AccentFillColorDefaultBrush}"><Border.RenderTransform><ScaleTransform ScaleY="0.07" /></Border.RenderTransform></Border>
                        <Border x:Name="IslandBar1" Width="2.5" Height="14" Margin="0,0,2.5,0" VerticalAlignment="Bottom" CornerRadius="1.25" RenderTransformOrigin="0,1" Background="{DynamicResource AccentFillColorDefaultBrush}"><Border.RenderTransform><ScaleTransform ScaleY="0.07" /></Border.RenderTransform></Border>
                        <Border x:Name="IslandBar2" Width="2.5" Height="14" Margin="0,0,2.5,0" VerticalAlignment="Bottom" CornerRadius="1.25" RenderTransformOrigin="0,1" Background="{DynamicResource AccentFillColorDefaultBrush}"><Border.RenderTransform><ScaleTransform ScaleY="0.07" /></Border.RenderTransform></Border>
                        <Border x:Name="IslandBar3" Width="2.5" Height="14" Margin="0,0,2.5,0" VerticalAlignment="Bottom" CornerRadius="1.25" RenderTransformOrigin="0,1" Background="{DynamicResource AccentFillColorDefaultBrush}"><Border.RenderTransform><ScaleTransform ScaleY="0.07" /></Border.RenderTransform></Border>
                        <Border x:Name="IslandBar4" Width="2.5" Height="14" VerticalAlignment="Bottom" CornerRadius="1.25" RenderTransformOrigin="0,1" Background="{DynamicResource AccentFillColorDefaultBrush}"><Border.RenderTransform><ScaleTransform ScaleY="0.07" /></Border.RenderTransform></Border>
                    </StackPanel>
                    <Grid x:Name="IslandMeter"
                          Width="0"
                          Height="4"
                          Margin="0"
                          VerticalAlignment="Center"
                          ClipToBounds="True"
                          Visibility="Collapsed">
                        <Border CornerRadius="2"
                                Opacity="0.28"
                                Background="{DynamicResource Bar.TextPrimary}" />
                        <Border x:Name="IslandMeterFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Grid>
                    <Border x:Name="IslandSatelliteFirst"
                            Style="{StaticResource IslandSatelliteHit}"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="OnIslandFirstSatelliteClick">
                        <TextBlock x:Name="IslandSatelliteFirstGlyph"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   Width="16"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Bar.TextPrimary}"
                                   IsHitTestVisible="False" />
                    </Border>
                    <Border x:Name="IslandSatelliteSecond"
                            Style="{StaticResource IslandSatelliteHit}"
                            Visibility="Collapsed"
                            MouseLeftButtonUp="OnIslandSecondSatelliteClick">
                        <TextBlock x:Name="IslandSatelliteSecondGlyph"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="13"
                                   Width="16"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Bar.TextPrimary}"
                                   IsHitTestVisible="False" />
                     </Border>
                 </StackPanel>
            </Border>

            <!-- Right cluster (runtime order from config; default LTR):
                 trayMirror · overflow · dateTime · notifications · controlCenter · network · battery.
                 volume / brightness / media stay in the catalog but are off by default.
                 A short drag reorders visible items; a click under the threshold still opens the flyout.
                 Tray icons are not strip slots: a short click forwards, a longer drag parks them
                 in the overflow capsule (TrayOverflowPopup). StatusDropCue is the insertion line
                 (not a strip child, so it does not shift slots). -->
            <StackPanel x:Name="StatusStrip"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Border x:Name="TrayMirrorHost"
                        Style="{StaticResource StatusHit}"
                        Padding="2,2"
                        Margin="0,0,2,0"
                        Visibility="Collapsed">
                    <ItemsControl x:Name="TrayMirrorItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <Border x:Name="TrayOverflowButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_TrayOverflow}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="TrayOverflowGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE70E;" />
                </Border>


                <Border x:Name="DateTimeButton"
                        Style="{StaticResource StatusHit}"
                        Padding="8,2,4,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_DateTime}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="ClockText"
                               Style="{StaticResource ClockCombinedLabel}"
                               Text="--" />
                </Border>

                <Border x:Name="NotificationsButton"
                        Style="{StaticResource StatusHit}"
                        Padding="4,2,6,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_Notifications}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NotificationsGlyph"
                               Style="{StaticResource StatusGlyph}"
                               VerticalAlignment="Center"
                               Text="&#xEA8F;" />
                </Border>

                <Border x:Name="ControlCenterButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_ControlCenter}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="ControlCenterGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE9E9;" />
                </Border>

                <Border x:Name="VolumeButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_Volume}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="VolumeGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE767;" />
                </Border>

                <Border x:Name="BrightnessButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_MonitorBrightness}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="BrightnessGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE706;" />
                </Border>

                <Border x:Name="MediaButton" Style="{StaticResource StatusHit}" Visibility="Collapsed">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_NowPlaying}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="MediaGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE90B;" />
                </Border>

                <Border x:Name="NetworkButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="{x:Static res:Strings.TopBar_Network}" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NetworkGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE701;" />
                </Border>

                <StackPanel x:Name="BatteryGroup"
                            Orientation="Horizontal"
                            Background="Transparent"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE83F;" />
                    <TextBlock x:Name="BatteryText"
                               Style="{StaticResource StatusLabel}"
                               Margin="2,0,0,0"
                               Text="" />
                </StackPanel>
            </StackPanel>

            <!-- Windows-style Show Desktop sliver, pinned to the screen's right edge.
                 A sibling of the strip, not a slot: the strip's drag-reorder and the
                 status item map treat it as nothing. Negative right margin reaches
                 past the 10 DIP bar margin; the strip needs the same 7 DIP back so
                 the hover plates never touch the sliver. -->
            <Border x:Name="ShowDesktopEdge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="7"
                    Margin="0,0,-10,0"
                    Cursor="Hand">
                <Border.ToolTip>
                    <ToolTip Content="{x:Static res:Strings.TopBar_ShowDesktop}" />
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Bar.HitFill}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Insertion caret for a status-strip drag. Overlay, so the slot measure stays put. -->
            <Border x:Name="StatusDropCue"
                    Width="2"
                    Height="18"
                    Margin="0"
                    CornerRadius="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" />

            <!-- Quick Settings (Win11-style): shared by controlCenter / volume / network.
                 PopupAnimation=None: the flyout plays its own slide+fade (AnimateFlyoutOpen /
                 AnimateFlyoutClose in code-behind); a layered popup (AllowsTransparency=True) is
                 required for that — it only affects the popup window, never the main window's Mica.
                 StaysOpen=True: no capture — outside clicks reach other windows; the flyout is
                 closed manually (WM_ACTIVATEAPP, topbar PreviewMouseDown, ESC, toggles) so the
                 close animation can play before IsOpen=false. -->
            <Popup x:Name="QuickSettingsPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=ControlCenterButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnQuickSettingsOpened"
                   Closed="OnQuickSettingsClosed">
                <local:QuickSettingsFlyout x:Name="QuickSettingsHost" />
            </Popup>

            <!-- Brightness Flyout (Monitorian-style) -->
            <Popup x:Name="BrightnessPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=BrightnessButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnBrightnessPopupOpened">
                <local:BrightnessFlyout x:Name="BrightnessHost" />
            </Popup>

            <!-- Clock panel: notifications + month. Same popup pattern; the bell stays Win+N. -->
            <Popup x:Name="ClockPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=DateTimeButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnClockPopupOpened">
                <local:ClockPanelFlyout x:Name="ClockPanelHost" />
            </Popup>

            <!-- Media Flyout (SMTC now playing) -->
            <Popup x:Name="MediaPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MediaButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnMediaPopupOpened">
                <local:MediaFlyout x:Name="MediaHost" />
            </Popup>

            <!-- Parked mirror icons. Same layered popup as the other flyouts; the bar stays Mica. -->
            <Popup x:Name="TrayOverflowPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TrayOverflowButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnTrayOverflowPopupOpened">
                <local:TrayOverflowFlyout x:Name="TrayOverflowHost" />
            </Popup>

            <!-- Island panel: the same Popup pattern (StaysOpen=True, PopupAnimation=None —
                 the open/close animation is in code-behind). Placement=Bottom aligns the left;
                 HorizontalOffset is pulled to the middle of the pill after measuring.
                 VerticalOffset=-12: popup starts 10 DIP above the panel top for the concave fillets; the panel still overlaps the pill by 2 DIP.
                 There is no second Popup inside the panel (docs/04-gotchas.md). -->
            <Popup x:Name="IslandPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=IslandPill}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="-12"
                   Opened="OnIslandPopupOpened"
                   Closed="OnIslandPopupClosed">
                <local:IslandFlyout x:Name="IslandHost"
                                    PreviewKeyDown="OnIslandKeyDown"
                                    MouseEnter="OnIslandPanelEnter"
                                    MouseLeave="OnIslandPanelLeave" />
            </Popup>
        </Grid>
    </Border>

</Window>
