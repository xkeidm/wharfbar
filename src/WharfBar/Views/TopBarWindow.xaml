<Window x:Class="WharfBar.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WharfBar.Views"
        Title="WharfBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        MinHeight="30"
        MaxHeight="30"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <!-- AllowsTransparency is set in the ctor from TopBar.BackgroundMode (before
         InitializeComponent) — never put it in XAML. Mica requires false; translucent
         modes require true; never pair AllowsTransparency=true with Mica. Windows logo
         uses geometry (not a font glyph) so Mica / missing MDL2 faces cannot blank it.
         Quick Settings flyout Popup stays opaque Fluent (AllowsTransparency=False). -->

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatusHit" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Win11-like clock: time over short date, shared with notification bell. -->
        <Style x:Key="ClockTimeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="ClockDateLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="10" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Background="Transparent">
        <Grid Margin="10,0">
            <!-- Left: Windows logo drawn as geometry (reliable on Mica). -->
            <Border x:Name="AppMenuButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Padding="6,4"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="800">
                <Border.ToolTip>
                    <ToolTip Content="WharfBar menüsü" />
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu x:Name="AppMenu">
                        <MenuItem Header="WharfBar hakkında" Click="OnAboutClick" />
                        <Separator />
                        <MenuItem Header="WharfBar'ı kapat" Click="OnQuitClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="11" Height="11">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="6" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- Right cluster, left→right toward the edge:
                 overflow · network · battery · ses · saat/tarih · bildirimler -->
            <StackPanel x:Name="StatusStrip"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Border x:Name="TrayOverflowButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Gizli simgeler" />
                    </Border.ToolTip>
                    <TextBlock x:Name="TrayOverflowGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE70E;" />
                </Border>

                <Border x:Name="NetworkButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ağ" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NetworkGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE701;" />
                </Border>

                <StackPanel x:Name="BatteryGroup"
                            Orientation="Horizontal"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE83F;" />
                    <TextBlock x:Name="BatteryText"
                               Style="{StaticResource StatusLabel}"
                               Margin="2,0,0,0"
                               Text="" />
                </StackPanel>

                <Border x:Name="VolumeButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ses" />
                    </Border.ToolTip>
                    <TextBlock x:Name="VolumeGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE767;" />
                </Border>

                <Border x:Name="DateTimeButton"
                        Style="{StaticResource StatusHit}"
                        Padding="8,2,4,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="Tarih ve saat" />
                    </Border.ToolTip>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText"
                                   Style="{StaticResource ClockTimeLabel}"
                                   Text="--:--" />
                        <TextBlock x:Name="DateText"
                                   Style="{StaticResource ClockDateLabel}"
                                   Text="--" />
                    </StackPanel>
                </Border>

                <Border x:Name="NotificationsButton"
                        Style="{StaticResource StatusHit}"
                        Padding="4,2,6,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="Bildirimler" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NotificationsGlyph"
                               Style="{StaticResource StatusGlyph}"
                               VerticalAlignment="Center"
                               Text="&#xEA8F;" />
                </Border>
            </StackPanel>

            <!-- Quick Settings (Win11-style): shared by volume + network. Opaque Fluent chrome —
                 AllowsTransparency stays false (never pair with Mica). -->
            <Popup x:Name="QuickSettingsPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=VolumeButton}"
                   StaysOpen="False"
                   AllowsTransparency="False"
                   PopupAnimation="Fade"
                   Opened="OnQuickSettingsOpened"
                   Closed="OnQuickSettingsClosed">
                <local:QuickSettingsFlyout x:Name="QuickSettingsHost" />
            </Popup>
        </Grid>
    </Border>

</Window>
