<Window x:Class="WharfBar.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WharfBar.Views"
        Title="WharfBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        MinHeight="30"
        MaxHeight="30"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <!-- AllowsTransparency is set in the ctor from TopBar.BackgroundMode (before
         InitializeComponent) — never put it in XAML. Mica requires false; translucent
         modes require true; never pair AllowsTransparency=true with Mica. Windows logo
         uses geometry (not a font glyph) so Mica / missing MDL2 faces cannot blank it.
         Quick Settings flyout Popup stays opaque Fluent (AllowsTransparency=False). -->

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- ContextMenu / MenuItem: App.xaml BasedOn WPF-UI (do not redefine without BasedOn). -->
        <Style x:Key="StatusHit" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Island pilli: ortadaki tek hedef. Diğer statü butonları gibi hover ile geri
             bildirim verir; 30 DIP'lik şeritte hedefi görünmez kılan yerleşim yanlış tıklamaya
             yol açıyor.

             MinWidth: boş durumda glif + "Boş" ~80 DIP'te kalıyordu; bu ada tek OLE bırakma
             hedefi olduğu için hedefi 120 DIP'e çıkarmak nişan almayı kolaylaştırır
             (canlı ölçüm Task 8'de). -->
        <Style x:Key="IslandPillHit" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Single-line clock+date (tr-TR abbreviations); sits beside notification bell. -->
        <Style x:Key="ClockCombinedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Background="Transparent">
        <Grid Margin="10,0">
            <!-- Left cluster: Windows logo + System Stats monitor -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Border x:Name="AppMenuButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Padding="6,4"
                        Cursor="Hand"
                        ToolTipService.InitialShowDelay="800">
                    <Border.ToolTip>
                        <ToolTip Content="WharfBar menüsü" />
                    </Border.ToolTip>
                    <Border.ContextMenu>
                        <ContextMenu x:Name="AppMenu" Loaded="OnAppMenuLoaded">
                            <MenuItem Header="Ayarlar (PC)" Click="OnOpenWindowsSettingsClick" />
                            <MenuItem Header="Profil" Click="OnOpenProfileClick" />
                            <MenuItem Header="Bilgisayar hakkında" Click="OnOpenAboutPcClick" />
                            <Separator />
                            <MenuItem Header="Bilgisayarı kilitle" Click="OnLockClick" />
                            <MenuItem Header="Uyku" Click="OnSleepClick" />
                            <MenuItem Header="Kapat" Click="OnShutdownClick" />
                            <MenuItem Header="Yeniden başlat" Click="OnRestartClick" />
                            <Separator />
                            <MenuItem Header="WharfBar Ayarları" Click="OnSettingsClick" />
                            <Separator />
                            <MenuItem Header="WharfBar hakkında" Click="OnAboutClick" />
                            <Separator />
                            <MenuItem Header="WharfBar'ı kapat" Click="OnQuitClick" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <Canvas Width="11" Height="11">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5" Height="5"
                                       Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Rectangle Canvas.Left="6" Canvas.Top="0" Width="5" Height="5"
                                       Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Rectangle Canvas.Left="0" Canvas.Top="6" Width="5" Height="5"
                                       Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Rectangle Canvas.Left="6" Canvas.Top="6" Width="5" Height="5"
                                       Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- System stats readout: "CPU 12% · GPU0 4% · GPU1 24% · RAM 47%" (SystemStatsService;
                     GPU segments numbered only with topBar.showGpuPerAdapter and 2+ adapters).
                     Hidden when topBar.showSystemStats is false; segments with no data drop out. -->
                <TextBlock x:Name="SystemStatsText"
                           Style="{StaticResource StatusLabel}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="--">
                    <TextBlock.ToolTip>
                        <ToolTip Content="İşlemci · Ekran kartı · Bellek kullanımı" />
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>

            <!-- Island: pano geçmişi + bırakılan dosya alanı. Yalnızca birincil monitörün
                 barında görünür (UpdateIslandPill), çünkü pano dinleyicisi ve kayıt listesi
                 uygulama genelinde tek tane; her barda bir ada çıkması aynı listeyi iki kez
                 göstermek ve hangi panelin açık olduğunu belirsizleştirmek olurdu.
                 Drop/DragOver/MouseLeftButtonUp tek blokta bağlıdır: aynı öğe iki adımda
                 düzenlenip biri atlanırsa olay sessizce ölü kalır.

                 Alt sıradaki çocuklar (StatusStrip) üst üste biner — kök Grid'de sütun yok,
                 üç küme aynı hücreyi paylaşıyor. Dar monitörde ortalanmış ada sağ kümeye
                 değdiği için önizleme tavanı statik tutulur (MaxWidth=160): genişlik tabanlı
                 gizleme altyapısı yok, ActualWidth/SizeChanged dinlenmiyor. Canlı ölçüm ve
                 gerekiyorsa tavanın düşürülmesi Task 8'in konusu. -->
            <Border x:Name="IslandPill"
                    Style="{StaticResource IslandPillHit}"
                    Margin="24,0"
                    Visibility="Collapsed"
                    AllowDrop="True"
                    MouseLeftButtonUp="OnIslandPillClick"
                    Drop="OnIslandPillDrop"
                    DragOver="OnIslandDragOver">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IslandGlyph"
                               Text="&#x2261;"
                               FontSize="12"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="IslandPreviewText"
                               Text="Bo&#x15F;"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="160"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="IslandCountText"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Opacity="0.6"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Right cluster (runtime order from config; default LTR):
                 trayMirror · overflow · dateTime · notifications · controlCenter · volume · network · battery -->
            <StackPanel x:Name="StatusStrip"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Border x:Name="TrayMirrorHost"
                        Style="{StaticResource StatusHit}"
                        Padding="2,2"
                        Margin="0,0,2,0"
                        Visibility="Collapsed">
                    <ItemsControl x:Name="TrayMirrorItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <Border x:Name="TrayOverflowButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Gizli simgeler" />
                    </Border.ToolTip>
                    <TextBlock x:Name="TrayOverflowGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE70E;" />
                </Border>


                <Border x:Name="DateTimeButton"
                        Style="{StaticResource StatusHit}"
                        Padding="8,2,4,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="Tarih ve saat" />
                    </Border.ToolTip>
                    <TextBlock x:Name="ClockText"
                               Style="{StaticResource ClockCombinedLabel}"
                               Text="--" />
                </Border>

                <Border x:Name="NotificationsButton"
                        Style="{StaticResource StatusHit}"
                        Padding="4,2,6,2"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="Bildirimler" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NotificationsGlyph"
                               Style="{StaticResource StatusGlyph}"
                               VerticalAlignment="Center"
                               Text="&#xEA8F;" />
                </Border>

                <Border x:Name="ControlCenterButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Hızlı ayarlar" />
                    </Border.ToolTip>
                    <TextBlock x:Name="ControlCenterGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE9E9;" />
                </Border>

                <Border x:Name="VolumeButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ses" />
                    </Border.ToolTip>
                    <TextBlock x:Name="VolumeGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE767;" />
                </Border>

                <Border x:Name="BrightnessButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Monitör Parlaklığı" />
                    </Border.ToolTip>
                    <TextBlock x:Name="BrightnessGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE706;" />
                </Border>

                <Border x:Name="MediaButton" Style="{StaticResource StatusHit}" Visibility="Collapsed">
                    <Border.ToolTip>
                        <ToolTip Content="Çalan medya" />
                    </Border.ToolTip>
                    <TextBlock x:Name="MediaGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE90B;" />
                </Border>

                <Border x:Name="NetworkButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ağ" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NetworkGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE701;" />
                </Border>

                <StackPanel x:Name="BatteryGroup"
                            Orientation="Horizontal"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE83F;" />
                    <TextBlock x:Name="BatteryText"
                               Style="{StaticResource StatusLabel}"
                               Margin="2,0,0,0"
                               Text="" />
                </StackPanel>
            </StackPanel>

            <!-- Quick Settings (Win11-style): shared by controlCenter / volume / network.
                 PopupAnimation=None: the flyout plays its own slide+fade (AnimateFlyoutOpen /
                 AnimateFlyoutClose in code-behind); a layered popup (AllowsTransparency=True) is
                 required for that — it only affects the popup window, never the main window's Mica.
                 StaysOpen=True: no capture — outside clicks reach other windows; the flyout is
                 closed manually (WM_ACTIVATEAPP, topbar PreviewMouseDown, ESC, toggles) so the
                 close animation can play before IsOpen=false. -->
            <Popup x:Name="QuickSettingsPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=ControlCenterButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnQuickSettingsOpened"
                   Closed="OnQuickSettingsClosed">
                <local:QuickSettingsFlyout x:Name="QuickSettingsHost" />
            </Popup>

            <!-- Brightness Flyout (Monitorian-style) -->
            <Popup x:Name="BrightnessPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=BrightnessButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnBrightnessPopupOpened">
                <local:BrightnessFlyout x:Name="BrightnessHost" />
            </Popup>

            <!-- Media Flyout (SMTC şu an çalan) -->
            <Popup x:Name="MediaPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MediaButton}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnMediaPopupOpened">
                <local:MediaFlyout x:Name="MediaHost" />
            </Popup>

            <!-- Island paneli: aynı Popup kalıbı (StaysOpen=True, PopupAnimation=None —
                 açılış/kapanış animasyonu code-behind'de). Panelin içinde ikinci bir Popup
                 yok: liste ScrollViewer + StackPanel'dir (docs/04-gotchas.md). -->
            <Popup x:Name="IslandPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=IslandPill}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   VerticalOffset="10"
                   Opened="OnIslandPopupOpened"
                   Closed="OnIslandPopupClosed">
                <local:IslandFlyout x:Name="IslandHost" PreviewKeyDown="OnIslandKeyDown" />
            </Popup>
        </Grid>
    </Border>

</Window>
