<Window x:Class="WharfBar.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WharfBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        MinHeight="30"
        MaxHeight="30"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <!-- Opaque window, AllowsTransparency off (kills Mica). Windows logo uses a Path (not a
         font glyph) so Mica / missing MDL2 faces cannot blank it. Flyouts are Popups anchored
         below the bar — opaque Fluent brushes, no AllowsTransparency+Mica pairing. -->

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatusHit" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FlyoutChrome" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Background="Transparent">
        <Grid Margin="10,0">
            <!-- Left: Windows logo drawn as geometry (reliable on Mica). -->
            <Border x:Name="AppMenuButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Padding="6,4"
                    Cursor="Hand"
                    ToolTipService.InitialShowDelay="800">
                <Border.ToolTip>
                    <ToolTip Content="WharfBar menüsü" />
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu x:Name="AppMenu">
                        <MenuItem Header="WharfBar hakkında" Click="OnAboutClick" />
                        <Separator />
                        <MenuItem Header="WharfBar'ı kapat" Click="OnQuitClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="11" Height="11">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="6" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="5" Height="5"
                                   Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- Right cluster, left→right toward the edge:
                 overflow · network · battery · ses · tarih · saat · bildirimler -->
            <StackPanel x:Name="StatusStrip"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Border x:Name="TrayOverflowButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Gizli simgeler" />
                    </Border.ToolTip>
                    <TextBlock x:Name="TrayOverflowGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE70E;" />
                </Border>

                <Border x:Name="NetworkButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ağ" />
                    </Border.ToolTip>
                    <TextBlock x:Name="NetworkGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE701;" />
                </Border>

                <StackPanel x:Name="BatteryGroup"
                            Orientation="Horizontal"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE83F;" />
                    <TextBlock x:Name="BatteryText"
                               Style="{StaticResource StatusLabel}"
                               Margin="2,0,0,0"
                               Text="" />
                </StackPanel>

                <Border x:Name="VolumeButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Ses" />
                    </Border.ToolTip>
                    <TextBlock x:Name="VolumeGlyph"
                               Style="{StaticResource StatusGlyph}"
                               Text="&#xE767;" />
                </Border>

                <Border x:Name="DateButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Tarih" />
                    </Border.ToolTip>
                    <TextBlock x:Name="DateText"
                               Style="{StaticResource StatusLabel}"
                               Text="--" />
                </Border>

                <Border x:Name="ClockButton" Style="{StaticResource StatusHit}">
                    <Border.ToolTip>
                        <ToolTip Content="Saat" />
                    </Border.ToolTip>
                    <TextBlock x:Name="ClockText"
                               Style="{StaticResource StatusLabel}"
                               FontWeight="SemiBold"
                               Text="--:--" />
                </Border>

                <Border x:Name="NotificationsButton"
                        Style="{StaticResource StatusHit}"
                        Margin="0">
                    <Border.ToolTip>
                        <ToolTip Content="Bildirimler" />
                    </Border.ToolTip>
                    <TextBlock Style="{StaticResource StatusGlyph}"
                               Text="&#xEA8F;" />
                </Border>
            </StackPanel>

            <!-- Top-anchored Fluent flyouts (opaque; Placement=Bottom under the hit target). -->
            <Popup x:Name="VolumePopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=VolumeButton}"
                   StaysOpen="False"
                   AllowsTransparency="False"
                   PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutChrome}" MinWidth="260">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="13" Text="Ses" Margin="0,0,0,10" />
                        <DockPanel LastChildFill="True">
                            <Button x:Name="MuteButton"
                                    DockPanel.Dock="Left"
                                    MinWidth="36"
                                    Margin="0,0,10,0"
                                    Padding="6,4"
                                    Click="OnMuteClick"
                                    ToolTip="Sessiz" />
                            <TextBlock x:Name="VolumePercentText"
                                       DockPanel.Dock="Right"
                                       Width="36"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="0%" />
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    VerticalAlignment="Center"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OnVolumeSliderChanged" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="DateTimePopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=ClockButton}"
                   StaysOpen="False"
                   AllowsTransparency="False"
                   PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutChrome}" MinWidth="280">
                    <StackPanel>
                        <TextBlock x:Name="FlyoutClockText"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="--:--" />
                        <TextBlock x:Name="FlyoutDateText"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="0,2,0,12"
                                   Text="—" />
                        <Calendar x:Name="FlyoutCalendar"
                                  SelectionMode="SingleDate"
                                  IsTodayHighlighted="True" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>

</Window>
