<Window x:Class="WharfBar.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WharfBar.Views.Controls"
        Title="WharfBar Dock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        AllowsTransparency="True">

    <!-- ContextMenu / MenuItem styles live in App.xaml (BasedOn WPF-UI) so Fluent
         templates are not replaced by Aero2's light icon gutter. -->

    <!-- Layered window: the strip is a WPF-drawn rounded surface (theme-aware brush set from
         code), everything outside it is fully transparent AND click-through. The window is
         fixed at the maximum magnified extent (never resized during hover — SetWindowPos per
         frame stutters); the Surface hugs the DockStrip's live width and stays centred.

         The root Grid is the file-drop target and deliberately has NO Background: a hit
         region out here would add ~57 DIP of phantom hit area on each side of the plate,
         which is sized for the worst magnified width. Drop/DragOver are declared here in the
         same block (TopBarWindow.xaml:156-157 — a two-step edit silently leaves it dead). -->
    <Grid AllowDrop="True" DragOver="OnSurfaceDragOver" Drop="OnSurfaceDrop">
        <Border x:Name="Surface"
                Padding="12,6"
                Background="Transparent"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#1AFFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <!-- Grid (not a bare pair of children) because Border hosts a single child:
                 the 1 px inner highlight sits above the strip without intercepting input.
                 The 12 DIP horizontal inset matches the plate padding and keeps the line
                 inside the CornerRadius="12" arcs — at y = 7 DIP the plate edge is only
                 ~1.1 DIP in, so a full-width square-cornered line would paint two specks
                 of #24FFFFFF outside the plate. -->
            <Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="#24FFFFFF"
                        Margin="12,0,12,-1" IsHitTestVisible="False" />
                <controls:DockStrip x:Name="Strip" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Reorder affordance. A sibling of the plate, not a child: the plate resizes with
             the strip, so an indicator inside it would be dragged along. Anchored to the
             resting layout, so drags run with magnification switched off (OnCellMouseMove).
             Height and Margin are owned by ShowDropIndicator — no literal size here, so the
             line cannot disagree with the strip it measures. -->
        <Border x:Name="DropIndicator"
                Width="2"
                CornerRadius="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Visibility="Collapsed" />
    </Grid>
</Window>
