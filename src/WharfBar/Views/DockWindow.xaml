<Window x:Class="WharfBar.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WharfBar Dock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        AllowsTransparency="False">

    <!-- ContextMenu / MenuItem styles live in App.xaml (BasedOn WPF-UI) so Fluent
         templates are not replaced by Aero2's light icon gutter. -->

    <Border x:Name="Surface"
            Padding="12,6"
            Background="Transparent"
            CornerRadius="8">
        <ScrollViewer x:Name="DockScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      CanContentScroll="False"
                      PreviewMouseWheel="OnDockScrollViewerPreviewMouseWheel">
            <ItemsControl x:Name="Pins">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
