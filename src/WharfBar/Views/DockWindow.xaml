<Window x:Class="WharfBar.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WharfBar.Views.Controls"
        Title="WharfBar Dock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <!-- ContextMenu / MenuItem styles live in App.xaml (BasedOn WPF-UI) so Fluent
         templates are not replaced by Aero2's light icon gutter. -->

    <!-- AllowsTransparency is set in the ctor from dock.backgroundMode, before
         InitializeComponent. Mica is the plate itself (DWM). Tint and transparent rebuild
         the window as a layered rounded plate; there is no magnification halo around it.
         Drop/DragOver stay on this Grid (a two-step edit that splits them leaves drop dead). -->
    <Grid AllowDrop="True" DragOver="OnSurfaceDragOver" Drop="OnSurfaceDrop">
        <Border x:Name="Surface"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <controls:DockStrip x:Name="Strip" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Reorder affordance. A sibling of the plate, not a child: the plate resizes with
             the strip, so an indicator inside it would be dragged along. Anchored to the
             resting layout, so drags run with magnification switched off (OnCellMouseMove).
             Height and Margin are owned by ShowDropIndicator — no literal size here, so the
             line cannot disagree with the strip it measures. -->
        <Border x:Name="DropIndicator"
                Width="2"
                CornerRadius="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Visibility="Collapsed" />

        <!-- One flyout for window previews and folder stacks. Not nested. Window cards are
             WPF images, not DWM thumbnails: DwmRegisterThumbnail rejects a layered popup
             and a child HWND as the destination (docs/04-gotchas.md). MaxWidth fits four
             184 DIP cards with their 4 DIP margins plus the 8 DIP padding. -->
        <Popup x:Name="SurfaceFlyout"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None"
               Placement="Top">
            <Border x:Name="SurfaceFlyoutCard"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="8"
                    MaxWidth="800">
                <StackPanel x:Name="SurfaceFlyoutBody" />
            </Border>
        </Popup>

        <Popup x:Name="MinimizeCue"
               AllowsTransparency="True"
               Placement="Absolute">
            <Image x:Name="MinimizeShot"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="MinimizeScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
        </Popup>
    </Grid>
</Window>
