<ui:FluentWindow x:Class="WharfBar.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:WharfBar.Resources"
        Title="{x:Static res:Strings.Onboarding_WindowTitle}"
        Icon="pack://application:,,,/Assets/WharfBar.png"
        Height="720" Width="1080"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- The step bodies inherit the Window's primary text colour; accent Foreground never
             leaks in from WPF-UI navigation hosts here. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.Onboarding_WindowTitle}"
                     Padding="12,6,12,6"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/WharfBar.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left rail: brand + numbered step list. Rail items are code-built (theme-aware
                 DynamicResource references), so the labels/states stay live across a theme swap. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="18,20,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="38" Height="38"
                               Source="pack://application:,,,/Assets/WharfBar.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WharfBar" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static res:Strings.About_VersionPlaceholder}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.Onboarding_RailTagline}"
                               FontSize="11"
                               Margin="0,16,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel x:Name="RailSteps" />
                </StackPanel>
            </Border>

            <!-- Step content: the step UserControl owns its own ScrollViewer (nested scrollers
                 swallow the wheel), so the host only bounds the height. -->
            <!-- The pane (header + step body) slides in as one surface. The clip lives on the
                 static host, not on the pane: it must stay put while the pane is offset, so the
                 transitioning page is cut at the rail instead of moving its clip along with it. -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Grid x:Name="StepPane"
                      Margin="32,22,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,12,14">
                        <TextBlock x:Name="StepTitleText"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StepSubtitleText"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ContentControl x:Name="StepHost"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Focusable="False" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer: skip / progress / back / continue -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="SkipButton"
                           Grid.Column="0"
                           Content="{x:Static res:Strings.Onboarding_Skip}"
                           Appearance="Transparent"
                           Click="OnSkipClick" />

                <TextBlock x:Name="StepOfText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button x:Name="BackButton"
                           Grid.Column="2"
                           Content="{x:Static res:Strings.Onboarding_Back}"
                           MinWidth="104"
                           Margin="0,0,8,0"
                           Click="OnBackClick" />

                <ui:Button x:Name="NextButton"
                           Grid.Column="3"
                           Content="{x:Static res:Strings.Onboarding_Next}"
                           Appearance="Primary"
                           MinWidth="140"
                           IsDefault="True"
                           Click="OnNextClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
