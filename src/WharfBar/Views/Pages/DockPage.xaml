<Page x:Class="WharfBar.Views.Pages.DockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dock"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Page Title -->
            <TextBlock Text="Dock" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- İçerik Section -->
            <TextBlock Text="İçerik" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Dock Öğeleri" FontSize="14" FontWeight="Medium"
                                   VerticalAlignment="Center" />

                        <ui:Button x:Name="AddItemButton" Grid.Column="1"
                                   Content="Ekle" Height="30" />
                    </Grid>

                    <!-- Rows are DockSettingsRow instances built in DockPage.RebuildItems: each
                         one owns its own drag handlers and remove button, so no ItemTemplate. -->
                    <ItemsControl x:Name="ItemsPanel" />

                    <TextBlock x:Name="EmptyHint" Text="Dock boş. Bir uygulamayı Explorer'dan
                               doğrudan dock'a sürükleyebilir veya yukarıdan ekleyebilirsin."
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Davranış Section -->
            <TextBlock Text="Davranış" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="Pin24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                   
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Otomatik Gizle" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="Dock'u fare imleci yaklaşmadığında otomatik olarak ekran altından gizleyin"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    
                    <ui:ToggleSwitch x:Name="AutoHideToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Görünüm Section -->
            <TextBlock Text="Görünüm" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Apps24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <TextBlock Grid.Column="1" Text="Simge Boyutu" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        
                        <TextBlock x:Name="IconSizeLabel" Grid.Column="2" Text="24 DIP"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    
                    <Slider x:Name="IconSizeSlider" Grid.Row="1"
                            Minimum="16" Maximum="36"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Margin="36,12,0,4"
                            ValueChanged="OnIconSizeChanged" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Blur20" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Arka Plan" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="Mica gerçek sistem bulanıklığıdır; saydam ve renkli levhayı yeniden oluşturur"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <ComboBox x:Name="BackgroundCombo" Grid.Column="2" Width="190"
                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Mica (Bulanık)" />
                            <ComboBoxItem Content="Saydam (Transparent)" />
                            <ComboBoxItem Content="Renkli (Tint)" />
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="OpacityRow" Grid.Row="3" Margin="36,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Opaklık" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityLabel" Grid.Row="0" Grid.Column="1" Text="40%"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.ColumnSpan="2"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Margin="0,8,0,0"
                                ValueChanged="OnOpacityChanged" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="DockRow24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <TextBlock Grid.Column="1" Text="Konum" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />

                        <ComboBox x:Name="PositionCombo" Grid.Column="2" Width="180"
                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Orta (varsayılan)" />
                            <ComboBoxItem Content="Sol" />
                            <ComboBoxItem Content="Sağ" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Apps24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Çalışan Uygulamaları Göster" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="Sabitlenmemiş çalışan uygulamaları ve küçültülmüş pencereleri dock'ta göster"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="ShowRunningToggle" Grid.Column="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
