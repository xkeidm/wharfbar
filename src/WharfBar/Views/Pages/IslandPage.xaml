<Page x:Class="WharfBar.Views.Pages.IslandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:res="clr-namespace:WharfBar.Resources"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{x:Static res:Strings.Settings_Island}"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Page Title -->
            <TextBlock Text="{x:Static res:Strings.Settings_Island}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- Visibility -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_VisibilitySection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Clipboard20" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.IslandPage_ShowTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.IslandPage_ShowDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="EnabledToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Music -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_MusicSection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="MusicNote224" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.IslandPage_MusicVisibilityTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.IslandPage_MusicVisibilityDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ComboBox x:Name="MusicPresenceCombo" Grid.Column="2" Width="220"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="{x:Static res:Strings.IslandPage_MusicWhilePlaying}" />
                        <ComboBoxItem Content="{x:Static res:Strings.IslandPage_MusicBrief}" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Color" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Color24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Island color" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="Album color: while music plays, paints the pill and panel with the color taken from the cover art. System color: always the accent color. Neutral: no color."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ComboBox x:Name="ColorModeCombo" Grid.Column="2" Width="220"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="Album color" />
                        <ComboBoxItem Content="System color" />
                        <ComboBoxItem Content="Neutral" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Wallpaper -->
            <TextBlock Text="Wallpaper" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Image24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Transition effect" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="Animation applied while the wallpaper changes."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ComboBox x:Name="WallpaperTransitionCombo" Grid.Column="2" Width="220"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Fade" />
                        <ComboBoxItem Content="Blur + fade" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Accessibility24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Follow Windows animation" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="When on, the transition is not applied if Accessibility → Visual effects → Animation effects is turned off in Windows."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="WallpaperRespectToggle"
                                         Grid.Column="2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="WallpaperAnimationInfoText"
                               Text="Animation effects are off in Windows — the transition is not applied. Turn off tracking to still use the effect."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="36,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Color24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="WallpaperAccentTitleText" FontSize="14" FontWeight="Medium" />
                        <TextBlock x:Name="WallpaperAccentDescriptionText"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="WallpaperAccentToggle"
                                     Grid.Column="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Idle text -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_IdleSection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.IslandPage_IdleTextTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.IslandPage_IdleTextDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ComboBox x:Name="IdleLabelCombo" Grid.Column="2" Width="220"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="{x:Static res:Strings.IslandPage_IdleClipboard}" />
                        <ComboBoxItem Content="{x:Static res:Strings.IslandPage_IdleLastEntry}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Battery -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_BatterySection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Battery1020" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.IslandPage_LowBatteryTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock x:Name="LowBatteryValueText"
                                   Text="20"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{x:Static res:Strings.IslandPage_LowBatteryDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="LowBatteryErrorText" FontSize="12" Foreground="#E57373"
                                   Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBox x:Name="LowBatteryBox" Grid.Column="2" Width="110"
                             VerticalContentAlignment="Center" TextAlignment="Right"
                             FontFamily="Consolas" />
                </Grid>
            </Border>

            <!-- History -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_HistorySection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>

                    <!-- Retention mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static res:Strings.IslandPage_RetentionModeTitle}" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="{x:Static res:Strings.IslandPage_RetentionModeDescription}"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <ComboBox x:Name="PersistenceCombo" Grid.Column="2" Width="220"
                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="{x:Static res:Strings.IslandPage_RetentionSession}" />
                            <ComboBoxItem Content="{x:Static res:Strings.IslandPage_RetentionPersistent}" />
                        </ComboBox>
                    </Grid>

                    <!-- Retention period -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="CalendarLtr16" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static res:Strings.IslandPage_RetentionDaysTitle}" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="{x:Static res:Strings.IslandPage_RetentionDaysDescription}"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="RetentionBox" Grid.Column="2" Width="110"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 FontFamily="Consolas" />
                    </Grid>

                    <!-- Entry count -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="DocumentTable24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static res:Strings.IslandPage_MaxItemsTitle}" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="{x:Static res:Strings.IslandPage_MaxItemsDescription}"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="MaxItemsBox" Grid.Column="2" Width="110"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 FontFamily="Consolas" />
                    </Grid>

                    <TextBlock x:Name="LimitsErrorText" FontSize="12" Foreground="#E57373"
                               Margin="36,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Maintenance -->
            <TextBlock Text="{x:Static res:Strings.IslandPage_MaintenanceSection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenDropFolderButton" Content="{x:Static res:Strings.IslandPage_OpenDropFolder}" Click="OnOpenDropFolderClick" />
                        <Button x:Name="DeleteDroppedFilesButton" Content="{x:Static res:Strings.IslandPage_DeleteDroppedFiles}"
                                Margin="8,0,0,0" Click="OnDeleteDroppedFilesClick" />
                        <Button x:Name="ClearHistoryButton" Content="{x:Static res:Strings.IslandPage_ClearHistory}"
                                Margin="8,0,0,0" Click="OnClearHistoryClick" />
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.IslandPage_DeleteDroppedFilesNote}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{x:Static res:Strings.IslandPage_ClearHistoryNote}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
