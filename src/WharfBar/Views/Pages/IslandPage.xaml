<Page x:Class="WharfBar.Views.Pages.IslandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ada"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Page Title -->
            <TextBlock Text="Ada" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- Görünürlük -->
            <TextBlock Text="Görünürlük" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Clipboard20" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Adayı Göster" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="Kopyaladığınız metinleri ve adaya bıraktığınız dosyaları izleyin. Kapatırsanız pano dinleyicisi durur ve hiçbir kayıt alınmaz."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="EnabledToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Geçmiş -->
            <TextBlock Text="Geçmiş" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>

                    <!-- Saklama modu -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Saklama" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="Oturumluk: yalnız bellekte tutulur, WharfBar kapanınca silinir. Kalıcı: diske yazılır, yeniden açılışta geri gelir."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <ComboBox x:Name="PersistenceCombo" Grid.Column="2" Width="220"
                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Oturumluk (kapanınca silinir)" />
                            <ComboBoxItem Content="Kalıcı (diske yazılır)" />
                        </ComboBox>
                    </Grid>

                    <!-- Saklama süresi -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="CalendarLtr16" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Saklama Süresi (gün)" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="1–3650 arası. Yalnızca kalıcı modda uygulanır; oturumluk modda geçmiş zaten kapanınca silinir."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="RetentionBox" Grid.Column="2" Width="110"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 FontFamily="Consolas" />
                    </Grid>

                    <!-- Kayıt sayısı -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="DocumentTable24" FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="En Fazla Kayıt" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="10–5000 arası sert tavan. Her iki modda da uygulanır; aşan en eski kayıtlar düşer."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBox x:Name="MaxItemsBox" Grid.Column="2" Width="110"
                                 VerticalContentAlignment="Center" TextAlignment="Right"
                                 FontFamily="Consolas" />
                    </Grid>

                    <TextBlock x:Name="LimitsErrorText" FontSize="12" Foreground="#E57373"
                               Margin="36,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Bakım -->
            <TextBlock Text="Bakım" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenDropFolderButton" Content="Drop klasörünü aç" Click="OnOpenDropFolderClick" />
                        <Button x:Name="DeleteDroppedFilesButton" Content="Bırakılan dosyaları sil"
                                Margin="8,0,0,0" Click="OnDeleteDroppedFilesClick" />
                        <Button x:Name="ClearHistoryButton" Content="Tüm geçmişi temizle"
                                Margin="8,0,0,0" Click="OnClearHistoryClick" />
                    </StackPanel>

                    <TextBlock Text="“Bırakılan dosyaları sil” %AppData%\WharfBar\Drop klasörünü tarayarak tamamen boşaltır — kayıt, MaxItems budamasıyla düşmüş ya da önceden temizlenmiş yetim kopyaları da kapsar. Dosya kayıtları listeden düşer, pano metinlerine dokunmaz."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="“Tüm geçmişi temizle” listeyi boşaltır ama diskteki dosya kopyalarını silmez; onları ayrıca silmeniz gerekir."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
