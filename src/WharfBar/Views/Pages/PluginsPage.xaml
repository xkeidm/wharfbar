<Page x:Class="WharfBar.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:WharfBar.Views"
      Title="Eklentiler"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Frame-hosted pages inherit accent Foreground from NavigationView; pin body text. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <views:PluginGalleryView x:Name="Gallery" />
</Page>
