<Page x:Class="WharfBar.Views.Pages.TopBarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Üst Çubuk"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Page Title -->
            <TextBlock Text="Üst Çubuk" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- Durum Öğeleri Section -->
            <TextBlock Text="Durum Öğeleri" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Üst çubuğun sağ tarafında gösterilecek simgeleri seçin ve sırasını belirleyin"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12" />

            <!-- Dynamically populated in code-behind -->
            <StackPanel x:Name="StatusItemsPanel" />

            <ui:Button x:Name="ResetButton" Content="Varsayılana Sıfırla"
                       Icon="{ui:SymbolIcon ArrowReset24}"
                       HorizontalAlignment="Left" Margin="0,8,0,0"
                       Padding="16,8"
                       Click="OnResetClick" />

        </StackPanel>
    </ScrollViewer>
</Page>
