<Page x:Class="WharfBar.Views.Pages.VeilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:res="clr-namespace:WharfBar.Resources"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{x:Static res:Strings.Settings_Veil}"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <TextBlock Text="{x:Static res:Strings.Settings_Veil}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- Enable -->
            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Color24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.VeilPage_EnableTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.VeilPage_EnableDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="VeilEnabledSwitch"
                                     Grid.Column="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Color -->
            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.VeilPage_ColorTitle}" FontSize="14" FontWeight="Medium" Margin="0,0,0,10" />
                    <WrapPanel x:Name="ColorSwatches" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="{x:Static res:Strings.VeilPage_CustomColor}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ColorHexBox" Width="110" VerticalContentAlignment="Center"
                                 MaxLength="7" FontFamily="Consolas" />
                        <Button x:Name="PickColorButton" Content="{x:Static res:Strings.VeilPage_PickColor}" Margin="8,0,0,0"
                                Click="OnPickColorClick" />
                        <TextBlock x:Name="ColorErrorText" Text="{x:Static res:Strings.VeilPage_InvalidColor}"
                                   FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="Collapsed" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Opacity -->
            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.VeilPage_OpacityTitle}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpacityLabel" Grid.Column="1" Text="40%"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider x:Name="OpacitySlider" Grid.Row="1"
                            Minimum="0" Maximum="100"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            IsMoveToPointEnabled="True"
                            Margin="0,12,0,4"
                            ValueChanged="OnOpacityChanged" />
                </Grid>
            </Border>

            <!-- Shortcut -->
            <Border Style="{StaticResource PowerToysCard}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.VeilPage_HotkeyTitle}" FontSize="14" FontWeight="Medium" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Static res:Strings.VeilPage_HotkeyDescription}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Strings.VeilPage_CurrentHotkey}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HotkeyLabel" Text="Ctrl+F11" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CaptureHotkeyButton" Content="{x:Static res:Strings.VeilPage_ChangeHotkey}" Click="OnCaptureHotkeyClick" />
                        <Button x:Name="RemoveHotkeyButton" Content="{x:Static res:Strings.VeilPage_RemoveHotkey}" Margin="8,0,0,0" Click="OnRemoveHotkeyClick" />
                        <Button x:Name="ResetHotkeyButton" Content="{x:Static res:Strings.VeilPage_ResetHotkey}" Margin="8,0,0,0" Click="OnResetHotkeyClick" />
                    </StackPanel>

                    <TextBlock x:Name="CaptureHotkeyHint" Text="{x:Static res:Strings.VeilPage_CaptureHint}"
                               FontSize="12" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="HotkeyErrorText" FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
