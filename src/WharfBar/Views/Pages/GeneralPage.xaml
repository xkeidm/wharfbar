<Page x:Class="WharfBar.Views.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:WharfBar.Resources"
      Title="{x:Static res:Strings.Settings_General}"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PowerToysSubCard" TargetType="Border" BasedOn="{StaticResource PowerToysCard}">
            <Setter Property="Margin" Value="36,0,0,6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <TextBlock Text="{x:Static res:Strings.Settings_General}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <TextBlock Text="{x:Static res:Strings.General_StartupSection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.General_AutostartTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.General_AutostartDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <ui:ToggleSwitch x:Name="AutostartToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.General_LanguageSection}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Globe24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.General_LanguageTitle}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{x:Static res:Strings.General_LanguageDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="2" Width="190"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="{x:Static res:Strings.General_LanguageSystem}" />
                        <ComboBoxItem Content="{x:Static res:Strings.General_LanguageEnglish}" />
                        <ComboBoxItem Content="{x:Static res:Strings.General_LanguageTurkish}" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Name="LanguageRestartNote"
                       Text="{x:Static res:Strings.General_LanguageRestartNote}"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,8" Visibility="Collapsed" />

            <Button x:Name="QuitToApplyButton"
                    Content="{x:Static res:Strings.General_QuitToApply}"
                    HorizontalAlignment="Left" Margin="0,0,0,8"
                    Visibility="Collapsed" Click="OnQuitToApplyClick" />

        </StackPanel>
    </ScrollViewer>
</Page>
