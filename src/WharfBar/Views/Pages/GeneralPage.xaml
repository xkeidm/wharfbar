<Page x:Class="WharfBar.Views.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Genel"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PowerToysCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PowerToysSubCard" TargetType="Border" BasedOn="{StaticResource PowerToysCard}">
            <Setter Property="Margin" Value="36,0,0,6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="850" HorizontalAlignment="Left">

            <!-- Page Title -->
            <TextBlock Text="Genel" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <!-- Başlangıç Section -->
            <TextBlock Text="Başlangıç" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="20"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                   
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Windows ile Başlat" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="WharfBar'ı Windows açılışında otomatik olarak çalıştırın"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    
                    <ui:ToggleSwitch x:Name="AutostartToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Sistem İstatistikleri Section -->
            <TextBlock Text="Sistem İstatistikleri" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,8" />

            <Border Style="{StaticResource PowerToysCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="DataUsage24" FontSize="20"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                   
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Sistem İstatistiklerini Göster" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="CPU, GPU ve RAM kullanım metriklerini üst bar sol tarafında gösterin"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    
                    <ui:ToggleSwitch x:Name="SystemStatsToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Sub Cards -->
            <Border x:Name="CpuCard" Style="{StaticResource PowerToysSubCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="DeveloperBoard24" FontSize="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                   
                    <TextBlock Grid.Column="1" Text="CPU Kullanımı Rozeti" FontSize="13" VerticalAlignment="Center" />
                    
                    <ui:ToggleSwitch x:Name="CpuToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="GpuCard" Style="{StaticResource PowerToysSubCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                   
                    <TextBlock Grid.Column="1" Text="GPU Kullanımı Rozeti" FontSize="13" VerticalAlignment="Center" />
                    
                    <ui:ToggleSwitch x:Name="GpuToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="RamCard" Style="{StaticResource PowerToysSubCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:SymbolIcon Grid.Column="0" Symbol="Server24" FontSize="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                   
                    <TextBlock Grid.Column="1" Text="RAM Kullanımı Rozeti" FontSize="13" VerticalAlignment="Center" />
                    
                    <ui:ToggleSwitch x:Name="RamToggle"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
