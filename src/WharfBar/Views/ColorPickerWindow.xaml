<Window x:Class="WharfBar.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk seçici"
        Left="-32000"
        Top="-32000"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="True"
        Cursor="Cross"
        Topmost="True"
        LostKeyboardFocus="OnWindowLostKeyboardFocus">

    <!-- Dimming mask: sampling comes from the frozen BitBlt snapshot taken BEFORE this
         layered window is shown, so the mask never darkens a sample. -->
    <Grid x:Name="Root" Background="#59000000"
          MouseMove="OnRootMouseMove"
          PreviewMouseLeftButtonDown="OnRootPreviewMouseDown"
          PreviewKeyDown="OnRootPreviewKeyDown">
        <!-- Full-span crosshair at the cursor; hairlines only hit-test nothing. -->
        <Canvas x:Name="CrosshairLayer" IsHitTestVisible="False">
            <Rectangle x:Name="CrossH" Height="1" Fill="#CCFFFFFF" />
            <Rectangle x:Name="CrossV" Width="1" Fill="#CCFFFFFF" />
        </Canvas>

        <!-- Loupe swatch + HEX card, offset below-right of the cursor so the sampled
             point itself stays unobstructed. Placed via Margin (Grid child: attached
             Canvas properties would be ignored). -->
        <Canvas x:Name="LoupeLayer" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel AllowDrop="False">
                <Ellipse x:Name="LoupeSwatch"
                         Width="72"
                         Height="72"
                         Stroke="#B3FFFFFF"
                         StrokeThickness="2"
                         Fill="{DynamicResource ControlFillColorDefaultBrush}" />
                <Border x:Name="HexCard"
                        Margin="0,8,0,0"
                        Padding="10,6"
                        CornerRadius="8"
                        Background="#F00D0D0D"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="HexText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF"
                                   Text="…" />
                        <TextBlock x:Name="HintText"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#B3FFFFFF"
                                   Text="Tıkla: HEX'i panoya yaz · Esc: vazgeç" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#FFFFFFFF"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
