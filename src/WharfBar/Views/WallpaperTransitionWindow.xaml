<Window x:Class="WharfBar.Views.WallpaperTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WharfBarWallpaperGecis"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Black"
        AllowsTransparency="True">
    <Grid ClipToBounds="True">
        <!-- Incoming (new) wallpaper — fades in underneath the outgoing layer. -->
        <Image x:Name="ToLayer"
               Stretch="UniformToFill"
               Opacity="0"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="ToScale" ScaleX="1.04" ScaleY="1.04" />
            </Image.RenderTransform>
        </Image>
        <!-- Outgoing (previous) wallpaper — fades / blurs out. -->
        <Image x:Name="FromLayer"
               Stretch="UniformToFill"
               Opacity="1"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="FromScale" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
