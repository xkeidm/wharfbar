<UserControl x:Class="WharfBar.Views.PluginGalleryView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- NavigationView content inherits accent Foreground; pin body text like other settings pages. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,24,32,32">
        <StackPanel x:Name="Body" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Name="Heading"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="Intro"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="Sections" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
