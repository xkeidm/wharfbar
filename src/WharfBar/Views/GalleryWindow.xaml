<ui:FluentWindow x:Class="WharfBar.Views.GalleryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:WharfBar.Views"
        xmlns:res="clr-namespace:WharfBar.Resources"
        Title="{x:Static res:Strings.Gallery_Plugins}"
        Height="720"
        Width="680"
        MinHeight="520"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar"
                     Grid.Row="0"
                     Title="{x:Static res:Strings.Gallery_Plugins}"
                     Padding="12,6,12,6"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <views:PluginGalleryView x:Name="Gallery" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
