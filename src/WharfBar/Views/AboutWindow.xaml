<Window x:Class="WharfBar.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WharfBar hakkında"
        Icon="pack://application:,,,/Assets/WharfBar.png"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Width="40" Height="40"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Source="pack://application:,,,/Assets/WharfBar.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="WharfBar" />
        </StackPanel>

        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Opacity="0.85"
                   Text="Sürüm —" />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   Text="Windows, macOS ve Linux masaüstülerinden esinlenen üst çubuk ve dock. Fluent / Mica görünüm; görev çubuğu yerine geçen hibrit tepsi (yabancı tepsi ikonu çizilmez)." />

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   FontSize="11"
                   Opacity="0.7"
                   Text="MIT Lisans" />

        <Button Grid.Row="4"
                Margin="0,18,0,0"
                MinWidth="88"
                HorizontalAlignment="Right"
                Content="Tamam"
                IsDefault="True"
                Click="OnOkClick" />
    </Grid>
</Window>
