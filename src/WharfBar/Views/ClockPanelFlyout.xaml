<UserControl xmlns:res="clr-namespace:WharfBar.Resources" x:Class="WharfBar.Views.ClockPanelFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="320"
             MaxWidth="320"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Border x:Name="FlyoutRoot"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="12"
            Padding="16"
            Margin="0,0,12,0"
            SnapsToDevicePixels="True">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.Clock_Notifications}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="NotificationStatus"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="{x:Static res:Strings.Clock_ReadingNotifications}" />
            <ScrollViewer MaxHeight="220"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NotificationList" />
            </ScrollViewer>
            <Button x:Name="OpenCenterButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Padding="10,4"
                    Content="{x:Static res:Strings.Clock_OpenNotificationCenter}"
                    Click="OnOpenCenterClick" />

            <Grid Margin="0,18,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Padding="8,2"
                        Content="‹"
                        Click="OnPreviousMonthClick"
                        ToolTip="{x:Static res:Strings.Clock_PreviousMonth}" />
                <TextBlock x:Name="MonthTitle"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="" />
                <Button Grid.Column="2"
                        Padding="8,2"
                        Content="›"
                        Click="OnNextMonthClick"
                        ToolTip="{x:Static res:Strings.Clock_NextMonth}" />
            </Grid>
            <primitives:UniformGrid x:Name="CalendarDays" Columns="7" />
        </StackPanel>
    </Border>
</UserControl>
