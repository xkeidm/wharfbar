<UserControl x:Class="WharfBar.Views.IslandFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WharfBar.Resources"
             xmlns:local="clr-namespace:WharfBar.Views"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="IslandIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandPlayButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The prompter's play button: not a Button, a ToggleButton has its own state;
             the same accent top look is shared with IslandPlayButton. -->
        <Style x:Key="IslandPlayToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <!-- Keep it visible while disabled too: with nowhere to scroll the button is dimmed but legible. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="SurfaceRoot"
          HorizontalAlignment="Left"
          Margin="24,10,24,24"
          RenderTransformOrigin="0.5,0">
        <!-- Silhouette: shadowed fill + highlight outline, drawn in panel-local coordinates.
             Geometry may extend to negative y (fillets beside the pill); rendering is not clipped. -->
        <Canvas x:Name="SilhouetteLayer" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
            </Canvas.Effect>
            <Path x:Name="SilhouetteFill" />
            <Path x:Name="SilhouetteOutline" StrokeThickness="1" StrokeLineJoin="Round" />
        </Canvas>

    <Border x:Name="FlyoutRoot"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="480"
            MaxHeight="440"
            Background="Transparent"
            Padding="16"
            SnapsToDevicePixels="True">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="HubTabs" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="TabClipboard" Tag="clipboard" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="{x:Static res:Strings.Island_Clipboard}" Margin="0,0,4,0"
                    AutomationProperties.Name="{x:Static res:Strings.Island_Clipboard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE8C8;" />
                    <TextBlock x:Name="TabClipboardLabel" Text="{x:Static res:Strings.Island_Clipboard}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabWallpaper" Tag="wallpaper" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="Wallpaper" Margin="0,0,4,0"
                    AutomationProperties.Name="Wallpaper">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE91B;" />
                    <TextBlock x:Name="TabWallpaperLabel" Text="Wallpaper" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabMusic" Tag="music" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="{x:Static res:Strings.Island_Music}" Margin="0,0,4,0"
                    AutomationProperties.Name="{x:Static res:Strings.Island_Music}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE90C;" />
                    <TextBlock x:Name="TabMusicLabel" Text="{x:Static res:Strings.Island_Music}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabShelf" Tag="shelf" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="Shelf" Margin="0,0,4,0"
                    AutomationProperties.Name="Shelf">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE8B7;" />
                    <TextBlock x:Name="TabShelfLabel" Text="Shelf" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabPrompter" Tag="prompter" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="Prompter" Margin="0,0,4,0"
                    AutomationProperties.Name="Prompter">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE720;" />
                    <TextBlock x:Name="TabPrompterLabel" Text="Prompter" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabCamera" Tag="camera" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="{x:Static res:Strings.Island_Camera}" Margin="0,0,4,0"
                    AutomationProperties.Name="{x:Static res:Strings.Island_Camera}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE722;" />
                    <TextBlock x:Name="TabCameraLabel" Text="{x:Static res:Strings.Island_Camera}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
            <Button x:Name="TabColor" Tag="colorpicker" Style="{StaticResource IslandIconButton}"
                    Click="OnHubTabClick" ToolTip="Color" Margin="0,0,0,0"
                    AutomationProperties.Name="Color">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE790;" />
                    <TextBlock x:Name="TabColorLabel" Text="Color" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Grid x:Name="BodyHost" Grid.Row="1" ClipToBounds="True">
            <Border x:Name="AmbientGlow"
                    VerticalAlignment="Stretch"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <!-- Music and clipboard swap places on the same surface. There is no second Popup. -->
            <Grid x:Name="MusicBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{x:Static res:Strings.Island_NowPlaying}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Name="ClipboardAffordance"
                            Style="{StaticResource IslandIconButton}"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Click="OnHubTabClick"
                            Tag="clipboard"
                            ToolTip="{x:Static res:Strings.Island_ClipboardHistory}">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="14"
                                   Text="&#xE8C8;" />
                    </Button>
                </Grid>

                <Grid x:Name="MusicSessions" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IslandIconButton}"
                                Click="OnPreviousSessionClick"
                                ToolTip="{x:Static res:Strings.Media_PreviousSession}">
                            <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="12"
                                       Text="&#xE76B;" />
                        </Button>
                        <TextBlock x:Name="MusicSessionName"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.75" />
                        <Button Style="{StaticResource IslandIconButton}"
                                Click="OnNextSessionClick"
                                ToolTip="{x:Static res:Strings.Media_NextSession}">
                            <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="12"
                                       Text="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MusicNow" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MusicCover"
                            Width="88"
                            Height="88"
                            CornerRadius="14"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="MusicArt"
                                   Width="88"
                                   Height="88"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                            <TextBlock x:Name="MusicPlaceholder"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="&#xE90C;" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MusicTitle"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MusicArtist"
                                   FontSize="13"
                                   Opacity="0.7"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MusicEmpty"
                           Grid.Row="2"
                           Text="{x:Static res:Strings.Media_NothingPlaying}"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />

                <!-- Only when both position and duration exist. The slider only while CanSeek; otherwise a read-only bar. No percentage is written. -->
                <Grid x:Name="MusicTimeline" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="MusicProgressTrack" Height="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MusicProgressDone" Width="0*" />
                            <ColumnDefinition x:Name="MusicProgressRest" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                CornerRadius="2"
                                Opacity="0.28"
                                Background="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border x:Name="MusicProgressFill"
                                Grid.Column="0"
                                CornerRadius="2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Grid>
                    <Slider x:Name="MusicSeek"
                            Minimum="0"
                            Maximum="1"
                            Height="18"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            Visibility="Collapsed"
                            PreviewMouseLeftButtonUp="OnSeekPointerUp" />
                    <TextBlock x:Name="MusicTime"
                               Grid.Row="1"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Opacity="0.65"
                               HorizontalAlignment="Right" />
                </Grid>

                <StackPanel x:Name="MusicTransport"
                            Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,4">
                    <Button Style="{StaticResource IslandIconButton}"
                            Padding="12,8"
                            Click="OnPreviousTrackClick"
                            ToolTip="{x:Static res:Strings.Media_PreviousTrack}">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="MusicPlayButton"
                            Style="{StaticResource IslandPlayButton}"
                            FontSize="20"
                            Click="OnPlayPauseClick"
                            ToolTip="Play/Pause">
                        <TextBlock x:Name="MusicPlayGlyph"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   Text="&#xE768;" />
                    </Button>
                    <Button Style="{StaticResource IslandIconButton}"
                            Padding="12,8"
                            Click="OnNextTrackClick"
                            ToolTip="{x:Static res:Strings.Media_NextTrack}">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ClipboardBody">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="BackToMusicButton"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Style="{StaticResource IslandIconButton}"
                        Click="OnHubTabClick"
                        Tag="music"
                        Visibility="Collapsed"
                        ToolTip="{x:Static res:Strings.Island_BackToMusic}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="&#xE72B;" />
                        <TextBlock Text="{x:Static res:Strings.Island_Music}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppTextFontFamily}"
                                   FontSize="12" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ClipboardEmpty"
                           Grid.Row="1"
                           Grid.RowSpan="2"
                           Margin="16,28,16,28"
                           FontSize="13"
                           Opacity="0.65"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Text="{x:Static res:Strings.Island_EmptyHint}" />

                <Grid x:Name="SearchHost" Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.5"
                               IsHitTestVisible="False"
                               Text="{x:Static res:Strings.Island_SearchPlaceholder}" />
                </Grid>

                <ScrollViewer x:Name="ListScroll"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="EntryListPanel" />
                </ScrollViewer>

                <TextBlock x:Name="HintText"
                           Grid.Row="3"
                           Margin="2,8,2,0"
                           FontSize="11"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="WallpaperBody" Visibility="Collapsed">
                <local:WallpaperGalleryView x:Name="WallpaperHost" />
            </Grid>

            <!-- Shelf: dropped file entries as chips; rows are built in code
                 (the same pattern as in ClipboardBody). A single Popup remains. -->
            <Grid x:Name="ShelfBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ShelfScroll"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="ShelfList" />
                </ScrollViewer>

                <TextBlock x:Name="ShelfEmpty"
                           Grid.Row="0"
                           Margin="16,28,16,28"
                           FontSize="13"
                           Opacity="0.65"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Text="Dropped file entries stay here with their names — hold a chip and drag it to a folder." />

                <Button x:Name="ShelfClearButton"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Style="{StaticResource IslandIconButton}"
                        Padding="10,6"
                        Click="OnShelfClearClick"
                        ToolTip="Clears the shelf list; also deletes the copies under %AppData%\WharfBar\Drop (asks for confirmation).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                   VerticalAlignment="Center" Text="&#xE74D;" />
                        <TextBlock Text="Empty shelf" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppTextFontFamily}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Color: screen picker (the ColorPickerWindow overlay) + recent colors + the selected HEX.
                 Colors come from the session-scoped IslandPickedColors store. -->
            <Grid x:Name="ColorPickerBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="PickerScreenButton"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IslandIconButton}"
                        Padding="10,6"
                        Click="OnPickerScreenClick"
                        ToolTip="Samples the color from the screen under the cursor; the HEX is written to the clipboard (Esc to cancel).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                   VerticalAlignment="Center" Text="&#xE790;" />
                        <TextBlock Text="Pick screen color" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppTextFontFamily}" />
                    </StackPanel>
                </Button>

                <WrapPanel x:Name="PickerRecents" Grid.Row="1" Margin="2,10,0,0" Orientation="Horizontal" />

                <Grid Grid.Row="2" Margin="2,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PickerSwatch"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PickerHex"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PickerFeedback"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       Opacity="0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="PickerCopyButton"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Style="{StaticResource IslandIconButton}"
                                Padding="8,6"
                                Click="OnPickerCopyClick"
                                ToolTip="Copies the selected color's HEX code to the clipboard.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                           VerticalAlignment="Center" Text="&#xE8C8;" />
                                <TextBlock Text="Copy" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AppTextFontFamily}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="2,10,0,0"
                           FontSize="11"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           Text="The screen picker darkens the whole screen: click the color under the cursor to copy it to the clipboard as HEX; press Esc to cancel." />
            </Grid>

            <!-- Camera: large preview on top (while off the glyph + status text are visible),
                 below it the on/off row and the display-only microphone row. The frame comes only
                 from CameraMirrorHost; the enable request goes to the top bar via an event — the body
                 does NOT call Apply itself. The preview clip is built in code in the MusicCover pattern. -->
            <Grid x:Name="CameraBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CameraPreviewHost"
                        Grid.Row="0"
                        Height="180"
                        CornerRadius="14"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Grid>
                        <Image x:Name="CameraPreviewImage" Stretch="Uniform" />
                        <StackPanel x:Name="CameraPreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CameraPreviewGlyph"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Text="&#xE722;" />
                            <TextBlock x:Name="CameraStatusText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       FontFamily="{DynamicResource AppTextFontFamily}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.7"
                                       Text="{x:Static res:Strings.Qs_Off}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                   VerticalAlignment="Center" Text="&#xE722;" />
                        <TextBlock Text="{x:Static res:Strings.Island_Camera}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppTextFontFamily}" />
                    </StackPanel>
                    <ToggleButton x:Name="CameraToggleButton"
                                  Style="{StaticResource IslandPlayToggle}"
                                  HorizontalAlignment="Right"
                                  IsThreeState="False"
                                  Click="OnCameraToggleClick"
                                  ToolTip="Turns the camera preview on or off">
                        <TextBlock x:Name="CameraToggleGlyph"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="16"
                                   Text="&#xE722;" />
                    </ToggleButton>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                               VerticalAlignment="Center" Text="&#xE720;" />
                    <TextBlock Text="Microphone" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppTextFontFamily}" />
                    <TextBlock x:Name="MicStatusText" Margin="8,0,0,0" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" FontFamily="{DynamicResource AppTextFontFamily}"
                               Text="Unknown" />
                </StackPanel>
            </Grid>

            <!-- Prompter: reading editor on top (in Playing it scrolls automatically on its own;
                 dragging vertically with the text drags the same offset), below it transport + speed + actions.
                 The scroll source is the TextBox's inner ScrollViewer (PART_ContentHost). -->
            <Grid x:Name="PrompterBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox x:Name="PrompterEditor"
                             Height="220"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnPrompterEditorTextChanged"
                             PreviewMouseLeftButtonDown="OnPrompterEditorPreviewMouseDown"
                             PreviewMouseMove="OnPrompterEditorPreviewMouseMove"
                             PreviewMouseLeftButtonUp="OnPrompterEditorPreviewMouseUp" />
                    <TextBlock x:Name="PrompterEditorPlaceholder"
                               Margin="10,7,10,0"
                               VerticalAlignment="Top"
                               Opacity="0.5"
                               IsHitTestVisible="False"
                               Text="Type text, paste from clipboard, or load a .txt…" />
                </Grid>

                <StackPanel Grid.Row="1">
                    <!-- Transport row: play/pause + speed. -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="PrompterPlayPause"
                                          Style="{StaticResource IslandPlayToggle}"
                                          Click="OnPrompterPlayPauseClick"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="Play/Pause">
                                <TextBlock x:Name="PrompterPlayGlyph"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           FontFamily="{DynamicResource AppIconFontFamily}"
                                           FontSize="16"
                                           Text="&#xE768;" />
                            </ToggleButton>
                            <TextBlock x:Name="PrompterPlayLabel"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="Play" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Slider x:Name="PrompterSpeedSlider"
                                    Width="110"
                                    Minimum="0.5"
                                    Maximum="3.0"
                                    TickFrequency="0.1"
                                    Value="1.0"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnPrompterSpeedChanged"
                                    ToolTip="Reading speed" />
                            <TextBlock x:Name="PrompterSpeedLabel"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.75"
                                       Text="1.0×" />
                        </StackPanel>
                    </Grid>

                    <!-- Action row: back to start, load .txt, take from clipboard. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="PrompterReset"
                                Style="{StaticResource IslandIconButton}"
                                Padding="10,6"
                                Click="OnPrompterResetClick"
                                ToolTip="Restarts scrolling from the top; the text is kept."
                                Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                           VerticalAlignment="Center" Text="&#xE8FC;" />
                                <TextBlock Text="Back to start" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AppTextFontFamily}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PrompterLoadFile"
                                Style="{StaticResource IslandIconButton}"
                                Padding="10,6"
                                Click="OnPrompterLoadFileClick"
                                ToolTip="Load a text file (.txt)"
                                Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                           VerticalAlignment="Center" Text="&#xE8E5;" />
                                <TextBlock Text=".txt" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AppTextFontFamily}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PrompterFromClipboard"
                                Style="{StaticResource IslandIconButton}"
                                Padding="10,6"
                                Click="OnPrompterFromClipboardClick"
                                ToolTip="Takes the most recently copied text from the island history into the editor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" FontSize="13"
                                           VerticalAlignment="Center" Text="&#xE77F;" />
                                <TextBlock Text="Paste from clipboard" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AppTextFontFamily}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
