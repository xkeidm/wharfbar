<UserControl x:Class="WharfBar.Views.IslandFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="IslandIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource AppIconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandPlayButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="SurfaceRoot"
          HorizontalAlignment="Left"
          Margin="24,10,24,24"
          RenderTransformOrigin="0.5,0">
        <!-- Silhouette: shadowed fill + highlight outline, drawn in panel-local coordinates.
             Geometry may extend to negative y (fillets beside the pill); rendering is not clipped. -->
        <Canvas x:Name="SilhouetteLayer" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
            </Canvas.Effect>
            <Path x:Name="SilhouetteFill" />
            <Path x:Name="SilhouetteOutline" StrokeThickness="1" StrokeLineJoin="Round" />
        </Canvas>

    <Border x:Name="FlyoutRoot"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="420"
            MaxHeight="440"
            Background="Transparent"
            Padding="16"
            SnapsToDevicePixels="True">
        <Grid x:Name="BodyHost" ClipToBounds="True">
            <Border x:Name="AmbientGlow"
                    VerticalAlignment="Stretch"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <!-- Müzik ve pano aynı yüzeyde yer değiştirir. İkinci bir Popup yok. -->
            <Grid x:Name="MusicBody" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Şimdi çalıyor"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Name="ClipboardAffordance"
                            Style="{StaticResource IslandIconButton}"
                            HorizontalAlignment="Right"
                            Click="OnClipboardAffordanceClick"
                            ToolTip="Pano geçmişi">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="14"
                                   Text="&#xE8C8;" />
                    </Button>
                </Grid>

                <Grid x:Name="MusicSessions" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IslandIconButton}"
                                Click="OnPreviousSessionClick"
                                ToolTip="Önceki medya oturumu">
                            <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="12"
                                       Text="&#xE76B;" />
                        </Button>
                        <TextBlock x:Name="MusicSessionName"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.75" />
                        <Button Style="{StaticResource IslandIconButton}"
                                Click="OnNextSessionClick"
                                ToolTip="Sonraki medya oturumu">
                            <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="12"
                                       Text="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MusicNow" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MusicCover"
                            Width="88"
                            Height="88"
                            CornerRadius="14"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="MusicArt"
                                   Width="88"
                                   Height="88"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                            <TextBlock x:Name="MusicPlaceholder"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="&#xE90C;" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MusicTitle"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MusicArtist"
                                   FontSize="13"
                                   Opacity="0.7"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="MusicEmpty"
                           Grid.Row="2"
                           Text="Çalan medya yok"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />

                <!-- Konum ve süre ikisi de varsa. Kaydırıcı yalnız CanSeek iken; aksi halde salt okunur çubuk. Yüzde yazılmaz. -->
                <Grid x:Name="MusicTimeline" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="MusicProgressTrack" Height="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MusicProgressDone" Width="0*" />
                            <ColumnDefinition x:Name="MusicProgressRest" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                CornerRadius="2"
                                Opacity="0.28"
                                Background="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border x:Name="MusicProgressFill"
                                Grid.Column="0"
                                CornerRadius="2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Grid>
                    <Slider x:Name="MusicSeek"
                            Minimum="0"
                            Maximum="1"
                            Height="18"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            Visibility="Collapsed"
                            PreviewMouseLeftButtonUp="OnSeekPointerUp" />
                    <TextBlock x:Name="MusicTime"
                               Grid.Row="1"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Opacity="0.65"
                               HorizontalAlignment="Right" />
                </Grid>

                <StackPanel x:Name="MusicTransport"
                            Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,4">
                    <Button Style="{StaticResource IslandIconButton}"
                            Padding="12,8"
                            Click="OnPreviousTrackClick"
                            ToolTip="Önceki parça">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="MusicPlayButton"
                            Style="{StaticResource IslandPlayButton}"
                            FontSize="20"
                            Click="OnPlayPauseClick"
                            ToolTip="Oynat/Duraklat">
                        <TextBlock x:Name="MusicPlayGlyph"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="{DynamicResource AppIconFontFamily}"
                                   Text="&#xE768;" />
                    </Button>
                    <Button Style="{StaticResource IslandIconButton}"
                            Padding="12,8"
                            Click="OnNextTrackClick"
                            ToolTip="Sonraki parça">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="ClipboardBody">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="BackToMusicButton"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Style="{StaticResource IslandIconButton}"
                        Click="OnBackToMusicClick"
                        Visibility="Collapsed"
                        ToolTip="Müziğe dön">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="&#xE72B;" />
                        <TextBlock Text="Müzik"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppTextFontFamily}"
                                   FontSize="12" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ClipboardEmpty"
                           Grid.Row="1"
                           Grid.RowSpan="2"
                           Margin="16,28,16,28"
                           FontSize="13"
                           Opacity="0.65"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Text="Kopyalanan metin ve bırakılan dosyalar burada durur." />

                <Grid x:Name="SearchHost" Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.5"
                               IsHitTestVisible="False"
                               Text="Ara…" />
                </Grid>

                <ScrollViewer x:Name="ListScroll"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="EntryListPanel" />
                </ScrollViewer>

                <TextBlock x:Name="HintText"
                           Grid.Row="3"
                           Margin="2,8,2,0"
                           FontSize="11"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
