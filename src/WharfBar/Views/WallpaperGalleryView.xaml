<UserControl x:Class="WharfBar.Views.WallpaperGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- Strip thumb: subtle lift on hover, accent ring comes from the code-behind -->
        <Style x:Key="GalleryThumb" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Panel.ZIndex" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripArrow" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Seçili duvar kağıdının büyük önizlemesi; yeni seçim üstteki katmanla crossfade eder -->
        <Border x:Name="PreviewFrame"
                Grid.Row="0"
                Height="168"
                Margin="0,0,0,6"
                CornerRadius="10"
                ClipToBounds="True"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
            <Grid>
                <StackPanel x:Name="PreviewPlaceholder"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               Text="&#xE91B;" />
                    <TextBlock FontFamily="{DynamicResource AppTextFontFamily}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Opacity="0.7"
                               Text="Duvar kağıdı seç" />
                </StackPanel>
                <Image x:Name="PreviewBase" Stretch="UniformToFill" Visibility="Collapsed" />
                <Image x:Name="PreviewTop" Stretch="UniformToFill" Opacity="0" Visibility="Collapsed" />
                <Border x:Name="PreviewBadge"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,6,0"
                        Visibility="Collapsed"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False">
                    <TextBlock Text="✓"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#12121A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentHost" />
        </ScrollViewer>

        <Button x:Name="OpenFolderButton"
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10,6"
                HorizontalAlignment="Left"
                Cursor="Hand"
                Click="OpenFolderButton_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource AppIconFontFamily}"
                           VerticalAlignment="Center"
                           Text="&#xE838;" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="Klasörü aç" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
