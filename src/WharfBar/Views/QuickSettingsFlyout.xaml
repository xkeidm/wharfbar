<UserControl x:Class="WharfBar.Views.QuickSettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MaxWidth="380"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <UserControl.Resources>
        <Style x:Key="QsTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="QsTileActive" TargetType="Border" BasedOn="{StaticResource QsTile}">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="QsGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="QsTileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="QsIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- MAIN -->
            <Grid x:Name="MainPage" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid x:Name="TilesGrid"
                             Grid.Row="0"
                             Columns="3"
                             Rows="2"
                             Margin="0,0,0,4" />

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="10,8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="MasterMuteButton"
                                DockPanel.Dock="Left"
                                Style="{StaticResource QsIconButton}"
                                Content="&#xE767;"
                                Click="OnMasterMuteClick"
                                ToolTip="Sessiz" />
                        <Button x:Name="MixerChevronButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource QsIconButton}"
                                Content="&#xE713;  &#xE76C;"
                                Click="OnOpenMixerClick"
                                ToolTip="Ses karıştırıcı" />
                        <Slider x:Name="MasterVolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnMasterVolumeChanged" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <DockPanel>
                        <Button x:Name="SettingsGearButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource QsIconButton}"
                                Content="&#xE713;"
                                Click="OnSettingsClick"
                                ToolTip="Ayarlar" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Text="Hızlı ayarlar" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- MIXER (single device + dropdown + sessions) -->
            <Grid x:Name="MixerPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Style="{StaticResource QsIconButton}"
                            Content="&#xE76B;"
                            Click="OnBackToMainClick"
                            ToolTip="Geri" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Text="Ses karıştırıcı" />
                </DockPanel>

                <!-- Inline expander (not nested Popup): parent QS Popup is StaysOpen=False;
                     a child Popup steals focus and never shows the device list reliably. -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock FontSize="11"
                               Opacity="0.7"
                               Margin="2,0,0,4"
                               Text="Çıkış cihazı" />
                    <Border x:Name="DevicePickerButton"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnDevicePickerClick">
                        <DockPanel>
                            <TextBlock x:Name="DevicePickerChevron"
                                       DockPanel.Dock="Right"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"
                                       Text="&#xE70D;" />
                            <TextBlock x:Name="SelectedDeviceNameText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Text="—" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="DevicePickerPanel"
                            Margin="0,6,0,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            MaxHeight="220"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DevicePickerList" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,0,0,10"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="10,8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="MixerMasterMuteButton"
                                DockPanel.Dock="Left"
                                Style="{StaticResource QsIconButton}"
                                Content="&#xE767;"
                                Click="OnMixerMasterMuteClick"
                                ToolTip="Sessiz" />
                        <TextBlock x:Name="MixerMasterPercentText"
                                   DockPanel.Dock="Right"
                                   Width="28"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   FontSize="12"
                                   Text="0" />
                        <Slider x:Name="MixerMasterSlider"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnMixerMasterVolumeChanged" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,8" />
                    <ScrollViewer MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MixerSessionList" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- NETWORK -->
            <Grid x:Name="NetworkPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Style="{StaticResource QsIconButton}"
                            Content="&#xE76B;"
                            Click="OnBackToMainClick"
                            ToolTip="Geri" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Text="Ağ" />
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="NetworkGlyphLarge"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Text="&#xE839;" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NetworkTitleText"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Text="Ağ" />
                                <TextBlock x:Name="NetworkSubtitleText"
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextWrapping="Wrap"
                                           Text="—" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <Button Content="Ağ ayarlarını aç"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            HorizontalContentAlignment="Left"
                            Click="OnOpenNetworkSettingsClick" />
                    <Button Content="Wi-Fi ayarları"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            HorizontalContentAlignment="Left"
                            Click="OnOpenWifiSettingsClick" />
                    <Button Content="Ethernet ayarları"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            HorizontalContentAlignment="Left"
                            Click="OnOpenEthernetSettingsClick" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           Text="Durum .NET ağ API’lerinden okunur; sistem tepsi ikonları aynalanmaz." />
            </Grid>
        </Grid>
    </Border>
</UserControl>
