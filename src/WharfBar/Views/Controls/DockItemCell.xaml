<!-- x:ClassModifier="internal" (lowercase) is load-bearing: without it the markup compiler
     emits `public partial class DockItemCell` and the internal code-behind partial clashes
     with it (CS0262). -->
<UserControl x:Class="WharfBar.Views.Controls.DockItemCell"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Focusable="False"
             UseLayoutRounding="True">

    <!-- Geometry is pushed in by DockStrip so the panel stays the single source of
         measurement truth. Icons grow upward: RenderTransformOrigin is bottom-centre. -->
    <Grid x:Name="Root" Background="Transparent">

        <!-- The icon slot is a Border, not a bare Image: Image derives from FrameworkElement and
             has no Background (MC3072), so an Image is never hit-tested. This Border's
             Transparent Background is what puts the magnified — RenderTransform-expanded —
             icon back into the hit chain, so a pointer riding the top of a magnified icon
             still resolves up to Surface and hover does not collapse. -->
        <Border x:Name="IconImage"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
                <!-- Rounded square behind the glyph. Shown on hover, and while a window of
                     this app is restored on the desktop. Top-aligned so the indicator sits
                     below it, not inside it. -->
                <Border x:Name="HoverPlate"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Image x:Name="IconGlyph"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <!-- Accent ring only. Opacity pulses; the slot does not move or scale. -->
        <Border x:Name="AttentionPulse"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BorderThickness="2"
                CornerRadius="4"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />

        <!-- Thin progress under the glyph. Absent until a real taskbar reading arrives. -->
        <Grid x:Name="ProgressTrack"
              Height="2"
              Margin="8,0,8,8"
              VerticalAlignment="Bottom"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0.35" />
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" />
        </Grid>

        <!-- Several windows or processes of this one app. The running line stays;
             the count sits on the glyph so the lane metrics do not move. -->
        <Border x:Name="WindowCountBadge"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="1,1,1,0"
                MinWidth="14"
                Height="14"
                Padding="3,0"
                CornerRadius="7"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock x:Name="WindowCountText"
                       FontSize="9"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>

        <!-- Line under this icon, in the button's bottom lane. Long and accent when a
             window is restored; short and neutral when the app is only minimized.
             Width and color are pushed in by ApplyChrome. -->
        <Border x:Name="RunningPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="1"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Opacity="0"
                Visibility="Collapsed" />

    </Grid>
</UserControl>
