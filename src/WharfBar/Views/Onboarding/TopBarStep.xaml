<UserControl x:Class="WharfBar.Views.Onboarding.TopBarStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WharfBar.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignWidth="740"
             d:DesignHeight="560"
             Background="Transparent"
             Focusable="False"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Compact settings-page rows: one bar item per row. -->
        <Style x:Key="OnboardingItemRow" TargetType="Border" BasedOn="{StaticResource OnboardingCard}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="OnboardingRowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OnboardingValueLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,12">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <!-- Status items: the visible ones in their current order, disabled ones below. -->
            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_ItemsSection}"
                       Style="{StaticResource OnboardingSectionHeader}"
                       Margin="0,0,0,4" />
            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_ItemsHint}"
                       Style="{StaticResource OnboardingBody}"
                       Margin="0,0,0,10" />

            <StackPanel x:Name="VisibleItemsPanel" />

            <TextBlock x:Name="HiddenHeader"
                       Text="{x:Static res:Strings.Onboarding_TopBar_HiddenSection}"
                       Style="{StaticResource OnboardingSectionHeader}"
                       Margin="0,10,0,6"
                       Visibility="Collapsed" />
            <StackPanel x:Name="HiddenItemsPanel" />

            <!-- System stats: two rows, the GPU split only meaningful while stats are on. -->
            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_StatsSection}"
                       Style="{StaticResource OnboardingSectionHeader}"
                       Margin="0,16,0,8" />
            <Border Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Desktop24"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_StatsTitle}"
                                       Style="{StaticResource OnboardingRowTitle}" />
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_StatsDescription}"
                                       Style="{StaticResource OnboardingCardBody}" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="StatsToggle"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Checked="OnStatsToggled"
                                         Unchecked="OnStatsToggled" />
                    </Grid>

                    <Border Height="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="0,10,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="DualScreenDesktop24"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_GpuTitle}"
                                       Style="{StaticResource OnboardingRowTitle}" />
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_GpuDescription}"
                                       Style="{StaticResource OnboardingCardBody}" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="GpuPerAdapterToggle"
                                         Grid.Column="2"
                                         VerticalAlignment="Center"
                                         Checked="OnGpuPerAdapterToggled"
                                         Unchecked="OnGpuPerAdapterToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Background: mode plus a tint-only opacity row. -->
            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_BackgroundSection}"
                       Style="{StaticResource OnboardingSectionHeader}"
                       Margin="0,16,0,8" />
            <Border Style="{StaticResource OnboardingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Blur20"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_BackgroundTitle}"
                                       Style="{StaticResource OnboardingRowTitle}" />
                            <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_BackgroundDescription}"
                                       Style="{StaticResource OnboardingCardBody}" />
                        </StackPanel>

                        <ComboBox x:Name="BackgroundCombo"
                                  Grid.Column="2"
                                  Width="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnBackgroundModeChanged">
                            <ComboBoxItem Content="{x:Static res:Strings.Appearance_BackdropMica}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Appearance_BackdropTransparent}" />
                            <ComboBoxItem Content="{x:Static res:Strings.Appearance_BackdropTint}" />
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="OpacityRow" Margin="30,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Static res:Strings.Appearance_OpacityTitle}"
                                   Style="{StaticResource OnboardingRowTitle}" />
                        <TextBlock x:Name="OpacityLabel"
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource OnboardingValueLabel}" />

                        <Slider x:Name="OpacitySlider"
                                Grid.Row="1" Grid.ColumnSpan="2"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                Margin="0,8,0,0"
                                ValueChanged="OnOpacityChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OnboardingNote}">
                <TextBlock Text="{x:Static res:Strings.Onboarding_TopBar_BackgroundHint}"
                           Style="{StaticResource OnboardingCardBody}"
                           Margin="0" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
