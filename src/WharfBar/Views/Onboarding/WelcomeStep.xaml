<UserControl x:Class="WharfBar.Views.Onboarding.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WharfBar.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <!-- Hero: logo, wordmark + version, welcome title and one-line intro. -->
            <Grid Margin="0,4,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="112" Height="112"
                       VerticalAlignment="Top"
                       Margin="0,0,24,0"
                       Source="pack://application:,,,/Assets/WharfBar.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Brand wordmark (not translatable); reuses the shared brand-name string. -->
                        <TextBlock x:Name="WordmarkText"
                                   FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="VersionText"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0,0,5"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_Intro}"
                               Style="{StaticResource OnboardingBody}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- Three things the app adds to Windows. -->
            <Border Style="{StaticResource OnboardingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Navigation24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_BarTitle}"
                                   Style="{StaticResource OnboardingCardTitle}" />
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_BarBody}"
                                   Style="{StaticResource OnboardingCardBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource OnboardingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Dock24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_DockTitle}"
                                   Style="{StaticResource OnboardingCardTitle}" />
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_DockBody}"
                                   Style="{StaticResource OnboardingCardBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource OnboardingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="PaintBrush24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_CustomTitle}"
                                   Style="{StaticResource OnboardingCardTitle}" />
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_CustomBody}"
                                   Style="{StaticResource OnboardingCardBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sets expectations about the Windows taskbar up front. -->
            <Border Style="{StaticResource OnboardingNote}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Desktop24" FontSize="20"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,14,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_TaskbarTitle}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_TaskbarBody}"
                                   Style="{StaticResource OnboardingCardBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.Onboarding_Welcome_ReplayNote}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,20,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
