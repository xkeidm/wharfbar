<UserControl x:Class="WharfBar.Views.Onboarding.TourStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WharfBar.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="520"
             Focusable="False">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Mock status glyphs: small and quiet, the plate carries the shape. -->
        <Style x:Key="MockGlyph" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TourBulletIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="TourBulletText" TargetType="TextBlock" BasedOn="{StaticResource OnboardingCardBody}">
            <Setter Property="Margin" Value="9,0,0,0" />
        </Style>

        <Style x:Key="TourCardTitle" TargetType="TextBlock" BasedOn="{StaticResource OnboardingCardTitle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,0,8">

            <TextBlock Text="{x:Static res:Strings.Onboarding_Tour_Intro}"
                       Style="{StaticResource OnboardingBody}" />

            <!-- Decorative mini shell: the real 30 DIP bar, the desktop and the floating dock.
                 IsHitTestVisible=False — nothing here is interactive. -->
            <Border Margin="0,10,0,4"
                    Padding="8"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Border Grid.Row="0"
                            Height="32"
                            CornerRadius="6"
                            Padding="9,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Brand mark on the 128 grid from BrandLogo.BarGlyph (set in code-behind). -->
                            <Viewbox Grid.Column="0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                                <Canvas Width="128" Height="128">
                                    <Path x:Name="MockBrandGlyph" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Canvas>
                            </Viewbox>

                            <!-- Island pill: icon + placeholder content lines, no real text. -->
                            <Border Grid.Column="1"
                                    Width="250"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="11"
                                    Padding="10,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Clipboard24"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="9,0,0,0">
                                        <Border Width="66" Height="4" CornerRadius="2"
                                                Background="{DynamicResource TextFillColorSecondaryBrush}"
                                                Opacity="0.55" />
                                        <Border Width="34" Height="4" CornerRadius="2" Margin="6,0,0,0"
                                                Background="{DynamicResource TextFillColorSecondaryBrush}"
                                                Opacity="0.35" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Width="6" Height="6" CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Grid>
                            </Border>

                            <!-- Status strip: tray, notifications, quick settings, network, battery, clock. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Style="{StaticResource MockGlyph}" Symbol="Apps24" />
                                <ui:SymbolIcon Style="{StaticResource MockGlyph}" Symbol="Alert24" Margin="9,0,0,0" />
                                <ui:SymbolIcon Style="{StaticResource MockGlyph}" Symbol="Settings24" Margin="9,0,0,0" />
                                <ui:SymbolIcon Style="{StaticResource MockGlyph}" Symbol="Wifi124" Margin="9,0,0,0" />
                                <ui:SymbolIcon Style="{StaticResource MockGlyph}" Symbol="Battery524" Margin="9,0,0,0" />
                                <!-- Decorative sample time, not UI copy. -->
                                <TextBlock Text="14:32"
                                           FontSize="11"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Desktop between the bar and the dock: a tiny window for depth. -->
                    <Border Grid.Row="1"
                            Width="280" Height="42"
                            CornerRadius="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.55"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="9" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    CornerRadius="4,4,0,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" />
                            <StackPanel Grid.Row="1" Margin="10,7,10,0">
                                <Border Width="150" Height="3" CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                                        Opacity="0.35" />
                                <Border Width="108" Height="3" CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,0"
                                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                                        Opacity="0.22" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dock: pinned app placeholders, the launch tile in the middle. -->
                    <Border Grid.Row="2"
                            HorizontalAlignment="Center"
                            CornerRadius="14"
                            Padding="8,5"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Border Width="22" Height="22" CornerRadius="11" Margin="8,0,0,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Border Width="26" Height="26" CornerRadius="13" Margin="8,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <ui:SymbolIcon Symbol="Apps24"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border Width="22" Height="22" CornerRadius="11" Margin="8,0,0,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Border Width="22" Height="22" CornerRadius="11" Margin="8,0,0,0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- What the parts do: two columns of explanation cards. -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OnboardingCard}" Padding="14,12" Margin="0,0,8,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Navigation24" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource TourCardTitle}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_BarTitle}" />
                        </StackPanel>

                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="WindowNew24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_BarLogo}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Clipboard24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_BarIsland}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Globe24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_BarStatus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dock -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OnboardingCard}" Padding="14,12" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DockRow24" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource TourCardTitle}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_DockTitle}" />
                        </StackPanel>

                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Pin24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_DockPins}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="CursorClick24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_DockClick}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Launchpad and shortcuts -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OnboardingCard}" Padding="14,12" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource TourCardTitle}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_KeysTitle}" />
                        </StackPanel>

                        <Grid Margin="0,8,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Search24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_KeysWin}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Keyboard24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_KeysChords}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Power24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_KeysQuit}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource OnboardingCard}" Padding="14,12" Margin="0,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource TourCardTitle}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_SettingsTitle}" />
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Style="{StaticResource TourBulletIcon}" Symbol="Color24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TourBulletText}"
                                       Text="{x:Static res:Strings.Onboarding_Tour_SettingsBody}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
