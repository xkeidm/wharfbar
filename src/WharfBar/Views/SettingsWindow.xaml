<ui:FluentWindow x:Class="WharfBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:WharfBar.Resources"
        xmlns:pages="clr-namespace:WharfBar.Views.Pages"
        Title="{x:Static res:Strings.Settings_WindowTitle}"
        Height="720" Width="1060"
        MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <!-- Frame-hosted pages inherit accent Foreground from NavigationView; pin body text. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.Settings_WindowTitle}"
                     Padding="12,6,12,6"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <!-- Pages set ScrollViewer.CanContentScroll=False so this host does not wrap
             them in a DynamicScrollViewer. That wrapper measures with infinite height,
             the page ScrollViewer never scrolls, and it swallows the mouse wheel. -->
        <ui:NavigationView x:Name="NavView" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="240"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_General}"
                                       TargetPageType="{x:Type pages:GeneralPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Appearance}"
                                       TargetPageType="{x:Type pages:AppearancePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DarkTheme24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Dock}"
                                       TargetPageType="{x:Type pages:DockPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Pin24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Monitors}"
                                       TargetPageType="{x:Type pages:MonitorsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DualScreenDesktop24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_TopBar}"
                                       TargetPageType="{x:Type pages:TopBarPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Navigation24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Veil}"
                                       TargetPageType="{x:Type pages:VeilPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Island}"
                                       TargetPageType="{x:Type pages:IslandPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Clipboard20" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_Plugins}"
                                       TargetPageType="{x:Type pages:PluginsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Settings_About}"
                                       TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
