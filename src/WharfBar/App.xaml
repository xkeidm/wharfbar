<Application x:Class="WharfBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Initial dictionaries; ApplicationThemeManager swaps them to match the system. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Font resources dynamically assigned on OS detection (Win11: Segoe UI Variable / Segoe Fluent Icons, Win10: Segoe UI / Segoe MDL2 Assets) -->
            <FontFamily x:Key="AppTextFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
            </Style>

            <!-- Keep WPF-UI Fluent templates (UiContextMenu / UiMenuItem). A local Style
                 without BasedOn replaces them with Aero2 chrome — light SystemColors icon
                 gutter on a dark menu body, so themed SymbolIcon glyphs vanish. -->
            <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource UiContextMenu}">
                <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource UiMenuItem}">
                <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style TargetType="{x:Type ui:MenuItem}" BasedOn="{StaticResource WpfUiMenuItem}">
                <Setter Property="FontFamily" Value="{DynamicResource AppTextFontFamily}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
